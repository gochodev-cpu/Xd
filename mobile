-- Busca River Park Towers en workspace / Map (nombre puede variar)
local function FindRiverParkTowers()
    local names = { "River Park Towers", "RiverParkTowers", "River Park Tower", "RiverPark" }
    for _, n in ipairs(names) do
        local f = workspace:FindFirstChild(n) or (workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild(n))
        if f then return f end
    end
    -- fallback: cualquier hijo con "river" + "park" en el nombre
    for _, ch in ipairs(workspace:GetChildren()) do
        local ln = string.lower(ch.Name or "")
        if ln:find("river", 1, true) and ln:find("park", 1, true) then
            return ch
        end
    end
    local map = workspace:FindFirstChild("Map")
    if map then
        for _, ch in ipairs(map:GetChildren()) do
            local ln = string.lower(ch.Name or "")
            if ln:find("river", 1, true) and ln:find("park", 1, true) then
                return ch
            end
        end
    end
    return nil
end

-- Devuelve lista de carpetas raíz de apartamentos (Map + River Park + LargeApartments)
local function GetApartmentRootFolders()
    local roots = {}
    local map = workspace:FindFirstChild("Map")
    local mapApts = map and map:FindFirstChild("Apartments")
    if mapApts then table.insert(roots, mapApts) end
    local rpt = FindRiverParkTowers()
    if rpt then
        local rptApts = rpt:FindFirstChild("Apartments") or rpt:FindFirstChild("Apartments", true)
        if rptApts then
            table.insert(roots, rptApts)
        else
            -- a veces 2A/4A/5A están directo bajo el edificio
            table.insert(roots, rpt)
        end
    end
    -- LargeApartments → Apartments (Carver1..4) — búsqueda agresiva
    local function addLarge(root)
        if not root then return end
        local apts = root:FindFirstChild("Apartments") or root:FindFirstChild("Apartments", true)
        if apts then
            table.insert(roots, apts)
        else
            table.insert(roots, root)
        end
    end
    addLarge(workspace:FindFirstChild("LargeApartments"))
    if map then addLarge(map:FindFirstChild("LargeApartments")) end
    -- por si el nombre cambia o está anidado
    for _, d in ipairs(workspace:GetDescendants()) do
        local n = string.lower(d.Name or "")
        if n == "largeapartments" or n == "large apartments" or n == "largeapartment" then
            addLarge(d)
            break
        end
    end
    return roots
end

-- Compat: un solo folder (Map) por si algo viejo lo usa
local function GetApartmentsFolder()
    local roots = GetApartmentRootFolders()
    return roots[1]
end

local function IsVipAptName(name)
    if not name then return false end
    if VIP_APT_NAMES[name] then return true end
    -- 2A, 4A, 5A exactos o con sufijo (2A_1, etc.)
    if name == "2A" or name == "4A" or name == "5A" then return true end
    if string.match(name, "^2A") or string.match(name, "^4A") or string.match(name, "^5A") then
        return true
    end
    return false
end

local function IsAllowedAptFolder(folder)
    if not folder then return false end
    local name = folder.Name
    if IsVipAptName(name) then return true end
    for _, prefix in ipairs(ALLOWED_APT_PREFIXES) do
        if name == prefix or string.find(name, prefix, 1, true) == 1 then
            return true
        end
    end
    return false
end

local function GetAptPriority(folderName)
    -- Número más bajo = se elige primero.
    -- Orden pedido:
    -- 1 Compact → 2 Large/SingleHouse → 3 Casino/Carver → 4 LongHouse → 5 VIP (2A/4A/5A)
    if string.find(folderName, "CompactWalkupAPT", 1, true) == 1 then return 1 end
    if string.find(folderName, "LargeHouse", 1, true) == 1 then return 2 end
    if string.find(folderName, "SingleHouse", 1, true) == 1 then return 2 end
    if string.find(folderName, "Casino", 1, true) then return 3 end
    if string.find(folderName, "Carver", 1, true) == 1 then return 3 end
    if string.find(folderName, "LongHouseUnit", 1, true) == 1 then return 4 end
    if IsVipAptName(folderName) then return 5 end
    return 99
end

local function ForEachAptFolder(fn)
    local seen = {}
    local function try(folder)
        if not folder or seen[folder] then return end
        seen[folder] = true
        if IsAllowedAptFolder(folder) then
            fn(folder)
        end
    end
    for _, root in ipairs(GetApartmentRootFolders()) do
        for _, aptFolder in ipairs(root:GetChildren()) do
            try(aptFolder)
        end
    end
    -- VIP 2A/4A/5A en workspace (por si el path cambia)
    for _, name in ipairs({ "2A", "4A", "5A" }) do
        local f = workspace:FindFirstChild(name, true)
        if f and (f:IsA("Folder") or f:IsA("Model")) then
            try(f)
        end
    end
    -- SingleHouse1, SingleHouse2... suelen estar directo en workspace
    for _, ch in ipairs(workspace:GetChildren()) do
        if string.find(ch.Name, "SingleHouse", 1, true) == 1 then
            try(ch)
        end
    end
    local map = workspace:FindFirstChild("Map")
    if map then
        for _, ch in ipairs(map:GetChildren()) do
            if string.find(ch.Name, "SingleHouse", 1, true) == 1 then
                try(ch)
            end
        end
    end
    -- Carver1..Carver4 hard-scan (LargeApartments)
    for i = 1, 8 do
        local name = "Carver" .. tostring(i)
        local f = workspace:FindFirstChild(name, true)
        if f and (f:IsA("Folder") or f:IsA("Model")) then
            try(f)
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if (d:IsA("Folder") or d:IsA("Model")) and string.find(d.Name, "Carver", 1, true) == 1 then
            try(d)
        end
    end
end

local function GetOccupationText(board)
    if not board then return "" end
    for _, d in ipairs(board:GetDescendants()) do
        if d.Name == "Occupation" and (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) then
            return d.Text or ""
        end
    end
    -- SurfaceGui / Billboard con texto de venta
    for _, d in ipairs(board:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local t = string.lower(tostring(d.Text or ""))
            if t ~= "" and (string.find(t, "vacant", 1, true) or string.find(t, "sale", 1, true)
                or string.find(t, "occupied", 1, true) or string.find(t, "for sale", 1, true)) then
                return d.Text or ""
            end
        end
    end
    return ""
end

local function GetBoard(aptModel)
    if not aptModel then return nil end
    local b = aptModel:FindFirstChild("Board", true) or aptModel:FindFirstChild("Board")
    if b then return b end
    -- nombres alternativos
    for _, n in ipairs({ "SaleBoard", "ForSale", "BuyBoard", "Sign", "VacantBoard" }) do
        b = aptModel:FindFirstChild(n, true)
        if b then return b end
    end
    -- cualquier ProximityPrompt de compra bajo el unit
    for _, d in ipairs(aptModel:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local t = string.lower(tostring(d.ActionText or "") .. " " .. tostring(d.ObjectText or ""))
            if string.find(t, "buy", 1, true) or string.find(t, "rent", 1, true)
                or string.find(t, "claim", 1, true) or string.find(t, "purchase", 1, true)
                or string.find(t, "own", 1, true) then
                return d.Parent
            end
        end
    end
    return nil
end

