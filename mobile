customNameOn = false
customNombre = "💸RoomTheBest🎃"
customMini = "Boreals💸Free"

local function GetNameChar()
    local folder = workspace:FindFirstChild("Characters")
    if folder then
        local byName = folder:FindFirstChild(LocalPlayer.Name)
        if byName then return byName end
        for _, ch in ipairs(folder:GetChildren()) do
            if Players:GetPlayerFromCharacter(ch) == LocalPlayer then
                return ch
            end
        end
    end
    return LocalPlayer.Character
end

local function WriteTagText(tag, text)
    if not tag then return false end
    -- El juego pasa el texto del NameTag por su sistema de traduccion, que
    -- usa string.format: un "%" suelto en el nombre explota con
    -- "invalid option '%m' to 'format'". Se saca el % antes de escribirlo.
    text = tostring(text):gsub("%%", "")
    local ok = false
    local function trySet(inst)
        if inst and (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then
            inst.Text = tostring(text)
            ok = true
        end
    end
    trySet(tag:FindFirstChild("NameLabel", true))
    for _, d in ipairs(tag:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            local n = string.lower(d.Name or "")
            if n:find("name") or n:find("label") or n:find("text") or n == "title" then
                trySet(d)
            end
        end
    end
    if not ok then
        for _, d in ipairs(tag:GetDescendants()) do
            if d:IsA("TextLabel") then
                trySet(d)
                break
            end
        end
    end
    return ok
end

function ApplyCustomName()
    if not customNameOn then return false end
    local char = GetNameChar()
    if not char then return false end
    local head = char:FindFirstChild("Head") or char:FindFirstChild("head")
    if not head then return false end
    local ok = false
    if WriteTagText(head:FindFirstChild("NameTag"), customNombre) then ok = true end
    if WriteTagText(head:FindFirstChild("RankTag"), customMini) then ok = true end
    if WriteTagText(char:FindFirstChild("NameTag"), customNombre) then ok = true end
    if WriteTagText(char:FindFirstChild("RankTag"), customMini) then ok = true end
    return ok
end

