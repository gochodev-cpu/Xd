local lastUnderY = nil
local function PlaceUnderPot(farmPot)
    local potPart = GetPotPart(farmPot)
    if not potPart then return end
    if not EnsurePlatform() then return end
    local standCF = GetUnderPotCFrame(farmPot)
    if not standCF then return end
    local underPos = standCF.Position
    lastUnderY = underPos.Y
    local vip = IsVipPotContext(farmPot)
    local compact = IsCompactPotContext(farmPot)
    SetStatus(vip and "Nivel piso olla (VIP)..." or (compact and "Compact (bajo piso)..." or "Colocando debajo de la olla..."))
    -- Compact: plataforma casi a la misma Y del personaje (no subir de más)
    local platY = compact and (underPos.Y - 2.0) or (underPos.Y - 4.3)
    local tw = TweenService:Create(currentPlatform, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
