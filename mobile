    currentPlatform.CanCollide = true
    currentPlatform.Material = Enum.Material.Neon
    currentPlatform.Color = Color3.fromRGB(255, 25, 25) -- rojo vivo (MS + Mobile)
    currentPlatform.Transparency = 0.15
