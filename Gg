end

-- Restaurar partes borradas (Delete Mode)
RestoreDeletedParts = function(count)
    count = math.floor(tonumber(count) or 1)
    if count < 1 then count = 1 end
    local restored = 0
    while restored < count and deletedObjects and #deletedObjects > 0 do
        local data = table.remove(deletedObjects) -- ultimo primero
        local obj = data and data.object
        if obj then
            pcall(function()
                if data.parent then
                    obj.Parent = data.parent
                else
                    obj.Parent = workspace
                end
                if data.cframe and obj:IsA("BasePart") then
                    obj.CFrame = data.cframe
                end
                if data.size and obj:IsA("BasePart") then
                    obj.Size = data.size
                end
                if data.color and obj:IsA("BasePart") then
                    obj.Color = data.color
                end
                if data.transparency ~= nil and obj:IsA("BasePart") then
                    obj.Transparency = data.transparency
                end
                if data.cancollide ~= nil and obj:IsA("BasePart") then
                    obj.CanCollide = data.cancollide
                end
                if data.anchored ~= nil and obj:IsA("BasePart") then
                    obj.Anchored = data.anchored
                end
            end)
            restored = restored + 1
        end
    end
    return restored
end

