    -- Número más bajo = se elige primero.
    -- Orden pedido:
    -- 1 Compact → 2 Large/SingleHouse → 3 Casino/Carver → 4 LongHouse → 5 VIP (2A/4A/5A)
    if string.find(folderName, "CompactWalkupAPT", 1, true) == 1 then return 1 end
    if string.find(folderName, "LargeHouse", 1, true) == 1 then return 2 end
    if string.find(folderName, "SingleHouse", 1, true) == 1 then return 2 end
    if string.find(folderName, "Casino", 1, true) then return 3 end
    if string.find(folderName, "Carver", 1, true) == 1 then return 3 end
    if string.find(folderName, "LongHouseUnit", 1, true) == 1 then return 4 end
    if IsVipAptName(folderName) then return 5 end
    return 99
end

local function ForEachAptFolder(fn)
    local seen = {}
    local function try(folder)
        if not folder or seen[folder] then return end
        seen[folder] = true
        if IsAllowedAptFolder(folder) then
            fn(folder)
        end
    end
    for _, root in ipairs(GetApartmentRootFolders()) do
        for _, aptFolder in ipairs(root:GetChildren()) do
            try(aptFolder)
        end
    end
    -- VIP 2A/4A/5A en workspace (por si el path cambia)
    for _, name in ipairs({ "2A", "4A", "5A" }) do
        local f = workspace:FindFirstChild(name, true)
        if f and (f:IsA("Folder") or f:IsA("Model")) then
            try(f)
        end
    end
    -- SingleHouse1, SingleHouse2... suelen estar directo en workspace
    for _, ch in ipairs(workspace:GetChildren()) do
        if string.find(ch.Name, "SingleHouse", 1, true) == 1 then
            try(ch)
        end
    end
    local map = workspace:FindFirstChild("Map")
    if map then
        for _, ch in ipairs(map:GetChildren()) do
            if string.find(ch.Name, "SingleHouse", 1, true) == 1 then
                try(ch)
            end
        end
    end
    -- Carver1..Carver4 hard-scan (LargeApartments)
    for i = 1, 8 do
        local name = "Carver" .. tostring(i)
        local f = workspace:FindFirstChild(name, true)
        if f and (f:IsA("Folder") or f:IsA("Model")) then
            try(f)
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if (d:IsA("Folder") or d:IsA("Model")) and string.find(d.Name, "Carver", 1, true) == 1 then
            try(d)
        end
    end
end

local function GetOccupationText(board)
    if not board then return "" end
    for _, d in ipairs(board:GetDescendants()) do
        if d.Name == "Occupation" and (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) then
            return d.Text or ""
        end
    end
    -- SurfaceGui / Billboard con texto de venta
    for _, d in ipairs(board:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local t = string.lower(tostring(d.Text or ""))
            if t ~= "" and (string.find(t, "vacant", 1, true) or string.find(t, "sale", 1, true)
                or string.find(t, "occupied", 1, true) or string.find(t, "for sale", 1, true)) then
                return d.Text or ""
            end
        end
    end
    return ""
end

local function GetBoard(aptModel)
    if not aptModel then return nil end
    local b = aptModel:FindFirstChild("Board", true) or aptModel:FindFirstChild("Board")
    if b then return b end
    -- nombres alternativos
    for _, n in ipairs({ "SaleBoard", "ForSale", "BuyBoard", "Sign", "VacantBoard" }) do
        b = aptModel:FindFirstChild(n, true)
        if b then return b end
