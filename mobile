    local function FindPromptNear(pos, radius)
        radius = radius or 8
        local best, bestDist
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local part = obj.Parent
                local p
                if part:IsA("BasePart") then p = part.Position
                elseif part:IsA("Attachment") then p = part.WorldPosition
                else
                    local bp = part:FindFirstChildWhichIsA("BasePart") or (part.Parent and part.Parent:IsA("BasePart") and part.Parent)
                    if bp then p = bp.Position end
                end
                if p then
                    local d = (p - pos).Magnitude
                    if d <= radius and (not bestDist or d < bestDist) then best, bestDist = obj, d end
                end
            end
        end
        return best
    end

