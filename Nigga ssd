-- ADDON 1 — COMPRA MARSHMALLOW SIN DIALOGO (NPC 19)
--   ReliableRemoteEvent + payload 24 / 19 / index
--   1 = Gelatin   2 = Sugar Block Bag   3 = Water
--   Hook __namecall en newcclosure + checkcaller: solo se frena el timing de
--   este script, el trafico del juego pasa intacto. Payload identico al real.
-- ============================================================================
do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer = Players.LocalPlayer

    local NPC_ID = 19
    local ITEMS = {
        { name = "Gelatin",         index = 1 },
        { name = "Sugar Block Bag", index = 2 },
        { name = "Water",           index = 3 },
    }

    local cachedRE
    local function getRE()
        if cachedRE and cachedRE.Parent then return cachedRE end
        local ok, re = pcall(function()
            local folder = ReplicatedStorage:WaitForChild("RemoteEvents", 5)
            return folder and folder:WaitForChild("ReliableRemoteEvent", 5)
        end)
        cachedRE = (ok and re) or nil
        return cachedRE
    end

    local function toolList()
        local names = {}
        local function scan(c)
            if not c then return end
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") then names[#names + 1] = t.Name end
            end
        end
        scan(LocalPlayer:FindFirstChild("Backpack"))
        scan(LocalPlayer.Character)
        return names
    end

    local function countItem(name)
        local want = string.lower(name)
        local exact, loose = 0, 0
        for _, nm in ipairs(toolList()) do
            local ln = string.lower(nm)
            if ln == want then
                exact += 1
            elseif string.find(ln, want, 1, true) then
                loose += 1
            end
        end
        if exact > 0 then return exact end
        return loose
    end

    local Hook = { installed = false, tokens = 4, last = 0, old = nil }
    local HOOK_RATE = 0.07
    local MAX_TOKENS = 6
    local JITTER = 0.45

    local function refill()
        local now = os.clock()
        local dt = now - Hook.last
        if dt > 0 and Hook.tokens < MAX_TOKENS then
            Hook.tokens = math.min(MAX_TOKENS, Hook.tokens + dt / HOOK_RATE)
        end
        Hook.last = now
    end

    local function throttle()
        refill()
        while Hook.tokens < 1 do
            local w = (1 - Hook.tokens) * HOOK_RATE
            task.wait(w * (1 - JITTER + math.random() * JITTER * 2))
            refill()
        end
        Hook.tokens -= 1
        task.wait(HOOK_RATE * (1 - JITTER + math.random() * JITTER * 2))
    end

    local function isBuyPayload(v1)
        if typeof(v1) ~= "buffer" or buffer.len(v1) ~= 3 then return false end
        local ok, res = pcall(function()
            local a, b, c = buffer.readu8(v1, 0), buffer.readu8(v1, 1), buffer.readu8(v1, 2)
            return a == 24 and b == NPC_ID and c >= 1 and c <= #ITEMS
        end)
        return ok and res
    end

    if typeof(hookmetamethod) == "function"
        and typeof(getnamecallmethod) == "function"
        and typeof(newcclosure) == "function" then
        Hook.old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local okM, method = pcall(getnamecallmethod)
            if okM and method == "FireServer" then
                local args = { ... }
                if #args == 1 and isBuyPayload(args[1]) then
                    if typeof(checkcaller) ~= "function" or checkcaller() then
                        throttle()
                    end
                end
            end
            return Hook.old(self, ...)
        end))
        Hook.installed = true
    else
        print("[BuyM] executor sin hookmetamethod/newcclosure — envio directo")
    end

    local function fireBuy(re, v1)
        if not (typeof(re) == "Instance" and re.Parent) then return false end
        if not Hook.installed then throttle() end
        pcall(function() re:FireServer(v1) end)
        return true
    end

    local function buyPayload(index)
        local v1 = buffer.create(3)
        buffer.writeu8(v1, 0, 24)
        buffer.writeu8(v1, 1, NPC_ID)
        buffer.writeu8(v1, 2, index)
        return v1
    end

    local function buyItemCount(re, name, index, cantidad)
        cantidad = math.max(0, math.floor(cantidad or 1))
        if countItem(name) >= cantidad then return true end
        -- Rafaga: se disparan los que faltan con un gap corto y con jitter, y
        -- se confirma una sola vez al final. Antes esperaba 1.2s POR ITEM con
        -- 60 vueltas de tope: lentisimo. Ahora van ~0.07-0.10s entre disparos,
        -- por debajo del techo del token bucket, asi no se nota el patron.
        local v1 = buyPayload(index)
        local rondas = 0
        while countItem(name) < cantidad and rondas < 3 do
            rondas += 1
            local falta = cantidad - countItem(name)
            for _ = 1, falta do
                fireBuy(re, v1)
                task.wait(0.07 + math.random() * 0.03)
            end
            local t0 = os.clock()
            while os.clock() - t0 < 1.2 do
                if countItem(name) >= cantidad then break end
                task.wait(0.05)
            end
        end
        return countItem(name) >= cantidad
    end

    local function BuyMarshmallows(cantidad)
        cantidad = math.clamp(math.floor(cantidad or 1), 1, 50)
        local re = getRE()
        if not re then
            print("[BuyM] no ReliableRemoteEvent")
            return false
        end
        local okAll = true
        for _, it in ipairs(ITEMS) do
            local ok = buyItemCount(re, it.name, it.index, cantidad)
            print("[BuyM] " .. it.name .. " -> " .. tostring(countItem(it.name)) ..
                "/" .. tostring(cantidad) .. (ok and " ok" or " corto"))
            okAll = ok and okAll
            task.wait(0.08)
        end
        return okAll
    end

    getgenv().SilentX_BuyMarshmallow = BuyMarshmallows
    getgenv().SilentX_BuyMarshmallowInfo = {
        npc = NPC_ID, items = ITEMS, hook = Hook, count = countItem, remote = getRE,
    }
end



