local function pad(o, l, t, r, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 14) p.PaddingTop = UDim.new(0, t or 12)
    p.PaddingRight = UDim.new(0, r or 14) p.PaddingBottom = UDim.new(0, b or 12)
    p.Parent = o
end

