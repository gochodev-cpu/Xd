    end

    -- estado del potato para la seccion Potato Status
    getgenv().Boreals_PotatoStatus = function()
        local seg = getgenv().PotatoTimeSegStart or 0
        local secs = getgenv().PotatoTimeAccum or 0
        if seg > 0 then secs = secs + (tick() - seg) end
        return {
            activo = PotatoFarmActive and true or false,
            post = PotatoPostRunning and true or false,
            chips = PotatoChipsHechos or 0,
            dinero = PotatoMoneyMade or 0,
            segundos = secs,
        }
    end

