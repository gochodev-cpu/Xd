    -- remote no entrego los items: antes, sin Potato en la mochila, el ciclo
    -- se quedaba en "poner el potato" sin nada que equipar.
    local function BuyViaShop(cantidad)
        if not farmActive then return false end
        if not PlayerGui:FindFirstChild("Shop") then
            if not PlayerGui:FindFirstChild("DialogueUI") then
                local prompt = GetLuciaPrompt()
                if not prompt then return false end
                FirePrompt(prompt)
                task.wait(1.0)
            end
            for _ = 1, 6 do
                if PlayerGui:FindFirstChild("Shop") then break end
                if ClickDialogueResponse("looking for some goods") then break end
                if not PlayerGui:FindFirstChild("DialogueUI") and not PlayerGui:FindFirstChild("Shop") then
                    FirePrompt(GetLuciaPrompt())
                    task.wait(0.8)
                end
                task.wait(0.3)
            end
        end
        local shop = waitFor(function() return PlayerGui:FindFirstChild("Shop") end, 8)
        if not shop then return false end
        task.wait(0.5)
        local scrolling = shop.Main and shop.Main:FindFirstChild("ScrollingFrame")
        if not scrolling then return false end
        local flourFalta = math.max(0, cantidad - CountTool("Flour"))
        local potatoFalta = math.max(0, cantidad - CountTool("Potato"))
        if flourFalta > 0 then BuyItemByName(scrolling, "Flour", flourFalta) end
        if potatoFalta > 0 then BuyItemByName(scrolling, "Potato", potatoFalta) end
        task.wait(0.4)
        local exitBtn = shop.Main and shop.Main:FindFirstChild("Exit")
        if exitBtn then forceClick(exitBtn) end
        task.wait(0.5)
        return CountTool("Flour") >= cantidad and CountTool("Potato") >= cantidad
    end

