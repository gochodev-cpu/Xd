local UI_URL = "https://raw.githubusercontent.com/gochodev-cpu/UI/main/REPT"

local function loadUI()
    if getgenv().Library and getgenv().Library.Window then
        return getgenv().Library
    end
    local code
    local ok, err = pcall(function()
        code = game:HttpGet(UI_URL)
    end)
    if not ok or not code or #code < 100 then
        error("[Boreals] No se pudo bajar la UI: " .. tostring(err))
    end
    local fn, loadErr = loadstring(code)
    if not fn then
        error("[Boreals] loadstring UI falló: " .. tostring(loadErr))
    end
    local ret = fn()
    local Lib = getgenv().Library or ret
    if not Lib or not Lib.Window then
        error("[Boreals] Library no quedo_ok cargada")
    end
    getgenv().Library = Lib
    return Lib
end

