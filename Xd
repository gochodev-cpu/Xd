local function FindRiverParkTowers()
    local names = { "River Park Towers", "RiverParkTowers", "River Park Tower", "RiverPark" }
    for _, n in ipairs(names) do
        local f = workspace:FindFirstChild(n) or (workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild(n))
        if f then return f end
    end
    return nil
end

local function GetApartmentRootFolders()
    local roots = {}
    local map = workspace:FindFirstChild("Map")
    local mapApts = map and map:FindFirstChild("Apartments")
    if mapApts then table.insert(roots, mapApts) end
    local rpt = FindRiverParkTowers()
    if rpt then
        local rptApts = rpt:FindFirstChild("Apartments") or rpt:FindFirstChild("Apartments", true)
        if rptApts then table.insert(roots, rptApts) else table.insert(roots, rpt) end
    end
    return roots
end

local function IsVipAptName(name)
    if not name then return false end
    if VIP_APT_NAMES[name] then return true end
    if name == "2A" or name == "4A" or name == "5A" then return true end
    return false
end

local function IsAllowedAptFolder(folder)
    if not folder then return false end
    local name = folder.Name
    if IsVipAptName(name) then return true end
    for _, prefix in ipairs(ALLOWED_APT_PREFIXES) do
        if name == prefix or string.find(name, prefix, 1, true) == 1 then return true end
    end
    return false
end

local function GetAptPriority(folderName)
    if string.find(folderName, "CompactWalkupAPT", 1, true) == 1 then return 1 end
    if string.find(folderName, "LargeHouse", 1, true) == 1 then return 2 end
    if string.find(folderName, "SingleHouse", 1, true) == 1 then return 2 end
    if string.find(folderName, "Casino", 1, true) then return 3 end
    if string.find(folderName, "Carver", 1, true) == 1 then return 3 end
    if string.find(folderName, "LongHouseUnit", 1, true) == 1 then return 4 end
    if IsVipAptName(folderName) then return 5 end
    return 99
end

local function ForEachAptFolder(fn)
    local seen = {}
    local function try(folder)
        if not folder or seen[folder] then return end
        seen[folder] = true
        if IsAllowedAptFolder(folder) then fn(folder) end
    end
    for _, root in ipairs(GetApartmentRootFolders()) do
        for _, aptFolder in ipairs(root:GetChildren()) do try(aptFolder) end
    end
end

local function GetOccupationText(board)
    if not board then return "" end
    for _, d in ipairs(board:GetDescendants()) do
        if d.Name == "Occupation" and (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) then
            return d.Text or ""
        end
    end
    return ""
end

local function GetBoard(aptModel)
    if not aptModel then return nil end
    local b = aptModel:FindFirstChild("Board", true) or aptModel:FindFirstChild("Board")
    if b then return b end
    return nil
end

local function GetCookingPots(apt)
    local pots = {}
    if not apt then return pots end
    for _, d in ipairs(apt:GetDescendants()) do
        local n = string.lower(d.Name or "")
        if n == "cooking pot" or n == "cookingpot" then table.insert(pots, d) end
    end
    return pots
end

local function GetPotPart(pot)
    if not pot then return nil end
    if pot:IsA("BasePart") then return pot end
    return pot:FindFirstChildWhichIsA("BasePart", true)
end

local function IsVipPotContext(pot)
    local p = pot
    while p and p ~= workspace do
        if IsVipAptName(p.Name) then return true end
        p = p.Parent
    end
    return false
end

local function GetUnderPotCFrame(pot)
    local part = GetPotPart(pot)
    if not part then return nil end
    if IsVipPotContext(pot) then
        return CFrame.new(Vector3.new(part.Position.X, part.Position.Y - VIP_FLOOR_BELOW_POT, part.Position.Z))
    end
    return CFrame.new(part.Position - Vector3.new(0, UNDER_POT_OFFSET, 0))
end

local function FindOwnedApartment()
    local myName = string.lower(LocalPlayer.Name)
    local myDisplay = string.lower(LocalPlayer.DisplayName)
    local foundApt, foundName, foundFolder = nil, nil, nil
    ForEachAptFolder(function(aptFolder)
        if foundApt then return end
        local apt = aptFolder:FindFirstChild("Apartment") or aptFolder
        local board = GetBoard(apt) or GetBoard(aptFolder)
        if board then
            local text = string.lower(GetOccupationText(board))
            if text ~= "" and (string.find(text, myName, 1, true) or string.find(text, myDisplay, 1, true)) then
                foundApt, foundName, foundFolder = apt, aptFolder.Name, aptFolder
            end
        end
    end)
    return foundApt, foundName, foundFolder
end

local function IsAptFree(board)
    local text = string.lower(GetOccupationText(board))
    if text == "" or text == "empty" or text == "for sale" or text == "available"
        or string.find(text, "vacant", 1, true) or string.find(text, "none", 1, true) then
        return true
    end
    return false
end

local function GetFrontOfBoardCFrame(boardPart)
    local look = boardPart.CFrame.LookVector
    local front = -look
    local stand = boardPart.Position + front * 2.2
    return CFrame.new(Vector3.new(stand.X, math.max(boardPart.Position.Y - 1.2, 3), stand.Z), boardPart.Position)
end

local function ResolveBoardPart(board, apt, aptFolder)
    if not board then return nil end
    if board:IsA("BasePart") then return board end
    return board:FindFirstChildWhichIsA("BasePart", true)
end

local function FindFreeCompactWalkup()
    local candidates = {}
    ForEachAptFolder(function(aptFolder)
        local apt = aptFolder:FindFirstChild("Apartment") or aptFolder
        local board = GetBoard(apt) or GetBoard(aptFolder)
        if board and IsAptFree(board) then
            local pots = GetCookingPots(apt)
            if #pots == 0 then pots = GetCookingPots(aptFolder) end
            if #pots > 0 then
                local boardPart = ResolveBoardPart(board, apt, aptFolder)
                if boardPart and boardPart:IsA("BasePart") then
                    table.insert(candidates, {
                        apt = apt, aptFolder = aptFolder, name = aptFolder.Name,
                        board = board, cf = GetFrontOfBoardCFrame(boardPart),
                        priority = GetAptPriority(aptFolder.Name)
                    })
                end
            end
        end
    end)
    if #candidates == 0 then return nil end
    table.sort(candidates, function(a, b) return a.priority < b.priority end)
    return candidates[1]
end

local function DestroyPlatform()
    if stayConnection then stayConnection:Disconnect() stayConnection = nil end
    if currentPlatform then currentPlatform:Destroy() currentPlatform = nil end
    isProtecting = false
end

local function ForceGoUp()
    if not isProtecting or not currentPlatform then isProtecting = false return end
    local px = currentPlatform.Position.X
    local pz = currentPlatform.Position.Z
    local targetY = math.max(originalY, 25)
    local upTween = TweenService:Create(currentPlatform, TweenInfo.new(2.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(px, targetY - 4.3, pz)
    })
    upTween:Play()
    upTween.Completed:Wait()
    DestroyPlatform()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = CFrame.new(px, targetY, pz) end
end

local function EnsurePlatform()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if isProtecting and currentPlatform and currentPlatform.Parent then return true end
    isProtecting = true
    originalY = math.max(hrp.Position.Y, 5)
    local currentPos = hrp.Position
    currentPlatform = Instance.new("Part")
    currentPlatform.Name = "SafePlatform"
    currentPlatform.Size = Vector3.new(12, 1.5, 12)
    currentPlatform.Anchored = true
    currentPlatform.CanCollide = true
    currentPlatform.Material = Enum.Material.Neon
    currentPlatform.Color = Color3.fromRGB(255, 25, 25)
    currentPlatform.Transparency = 0.15
    currentPlatform.CFrame = CFrame.new(currentPos.X, currentPos.Y - 4, currentPos.Z)
    currentPlatform.Parent = workspace
    stayConnection = RunService.Heartbeat:Connect(function()
        if hrp and hrp.Parent and currentPlatform and currentPlatform.Parent then
            local p = currentPlatform.Position
            hrp.CFrame = CFrame.new(p.X, p.Y + 4.3, p.Z)
        end
    end)
    return true
end

local function SlowTravel(targetPosOrCF, label, riseSeconds)
    local targetPos = typeof(targetPosOrCF) == "CFrame" and targetPosOrCF.Position or targetPosOrCF
    if not targetPos then return false end
    if not EnsurePlatform() then return false end
    SetStatus(label or "Viajando...")

    local startY = currentPlatform.Position.Y
    local vertDown = math.abs(startY - SafeHeight)
    local downSeconds = math.clamp(vertDown / 8, 3.2, 12)

    local down = TweenService:Create(currentPlatform, TweenInfo.new(downSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
        CFrame = CFrame.new(currentPlatform.Position.X, SafeHeight, currentPlatform.Position.Z)
    })
    down:Play()
    down.Completed:Wait()

    local endPos = Vector3.new(targetPos.X, SafeHeight, targetPos.Z)
    while AutoMS do
        if not currentPlatform or not currentPlatform.Parent then return false end
        local current = currentPlatform.Position
        local remaining = (endPos - Vector3.new(current.X, SafeHeight, current.Z)).Magnitude
        if remaining <= 2 then break end
        local direction = (endPos - Vector3.new(current.X, SafeHeight, current.Z)).Unit
        local step = math.min(SPEED * 0.1, remaining)
        currentPlatform.CFrame = CFrame.new(Vector3.new(current.X, SafeHeight, current.Z) + direction * step)
        task.wait(0.1)
    end

    currentPlatform.CFrame = CFrame.new(targetPos.X, SafeHeight, targetPos.Z)
    task.wait(0.2)

    local destY = targetPos.Y - 4.3
    local upSeconds = riseSeconds or 4.5
    local up = TweenService:Create(currentPlatform, TweenInfo.new(upSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(targetPos.X, destY, targetPos.Z)
    })
    up:Play()
    up.Completed:Wait()
    task.wait(0.35)
    return true
end

local function GoDownAndUp(waitTime)
    if not EnsurePlatform() then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    originalY = math.max(hrp.Position.Y, 5)
    local px = currentPlatform.Position.X
    local pz = currentPlatform.Position.Z
    
    local downTween = TweenService:Create(currentPlatform, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(px, SafeHeight, pz)
    })
    downTween:Play()
    downTween.Completed:Wait()
    
    local t0 = tick()
    while tick() - t0 < waitTime and AutoMS do
        task.wait(0.1)
    end
    
    local upTween = TweenService:Create(currentPlatform, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(px, originalY - 4.3, pz)
    })
    upTween:Play()
    upTween.Completed:Wait()
end

