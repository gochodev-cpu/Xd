-- StartAutoMS: loop PC completo (compra → olla → venta) mientras AutoMS=true
StartAutoMS = function()
    if AutoMS then return end
    AutoMS = true
    FarmStartTime = tick()
    -- mismo que CardTimeSegStart = tick()
    getgenv().MsTimeSegStart = tick()
    MsTimeSegStart = getgenv().MsTimeSegStart
    if (SessionFarmStart or 0) == 0 then SessionFarmStart = tick() end
    ApproxStartTime = 0
    ApproxActive = false
    SetStatus("Iniciando...")
    task.spawn(function()
        local firstCycle = true
        while AutoMS do
            local okCycle = pcall(function()
                if firstCycle then
                    if not FindOwnedApartment() then
                        local free = FindFreeCompactWalkup()
                        if not free then
                            SetStatus("Depas Llenos")
                            AutoMS = false
                            getgenv().SilentXMsWanted = false
                            pcall(function()
                                if false and Library and Library.SetFlags and Library.SetFlags["GH_AutoMS"] then
                                    Library.SetFlags["GH_AutoMS"](false)
                                end
                            end)
                            return
                        end
                        SetStatus("Sin depa — comprando...")
                        if not BuyApartmentWithPot() then
                            task.wait(2)
                            return
                        end
                        -- Mask desactivado por ahora: tras depa → directo a ingredientes
                        if AutoMS then
                            SetStatus("Casa lista — yendo a tienda (9e9)...")
                        end
                    end
                    if not AutoMS then return end

                    -- TP 9e9 a la tienda (sin SlowTravel / plataforma)
                    SetStatus("Yendo a tienda (9e9)...")
                    local shopOk = false
                    pcall(function()
                        shopOk = Instant9e9To(ShopPosition) == true
                    end)
                    if not shopOk then
                        -- fallback: teleportear HRP
                        pcall(function()
                            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                hrp.CFrame = ShopPosition + Vector3.new(0, 3, 0)
                                shopOk = true
                            end
                        end)
                    end
                    if not shopOk then
                        SetStatus("Fallo TP tienda — reintentando...")
                        task.wait(1)
                        return
                    end
                    if not AutoMS then return end
                    pcall(function() DestroyPlatform() end)
                    ClearBlockersNear(ShopPosition.Position, SHOP_CLEAR_RADIUS)
                    task.wait(0.45)
                    if not AutoMS then return end

                    if not AutoBuyIngredients(farmAmount) then
                        SetStatus("Fallo compra — reintentando...")
                        task.wait(1.5)
                        return
                    end
                    if not AutoMS then return end
                    firstCycle = false
                end

                local ok, farmPot = GoToOwnedCookingPot()
                if not ok then
                    SetStatus("Fallo depa — reintentando...")
                    task.wait(1.5)
                    return
                end
                if not AutoMS then return end

                local potPart = farmPot and GetPotPart(farmPot)

                while AutoMS do
                    CheckLimitCash()
                    if HasNoIngredients() then break end
                    if potPart and potPart.Parent then
                        ClearAroundPot(nil, farmPot, 14)
                        PlaceUnderPot(farmPot)
                    elseif farmPot and farmPot.Parent then
                        potPart = GetPotPart(farmPot)
                    end

                    SetStatus("Poniendo Water...")
                    local usedWater = EquipAndUse2Times("Water", farmPot)
                    if usedWater and not ApproxActive then
                        ApproxActive = true
                        ApproxStartTime = tick()
                    end
                    if not AutoMS then break end
                    GoDownAndUp(18)
                    if not AutoMS then break end
                    PlaceUnderPot(farmPot)
                    SetStatus("Poniendo Sugar...")
                    EquipAndUse2Times("Sugar Block Bag", farmPot)
                    if not AutoMS then break end
                    task.wait(1.3)
                    if not AutoMS then break end
                    SetStatus("Poniendo Gelatin...")
                    EquipAndUse2Times("Gelatin", farmPot)
                    if not AutoMS then break end
                    GoDownAndUp(43)
                    if not AutoMS then break end
                    PlaceUnderPot(farmPot)
                    SetStatus("Usando Empty Bag...")
                    local empty = GetTool("Empty Bag") or GetTool("Empty") or GetTool("Bag")
                    if empty then EquipAndUse2Times(empty.Name, farmPot) end
                    BagsMade = (BagsMade or 0) + 1
                    SetStatus("Ciclo olla... bolsas " .. tostring(BagsMade))
                    task.wait(1.0)
                end
                if not AutoMS then return end

                local boughtAgain = FinishFarmAndSell()
                if not AutoMS then return end
                if not boughtAgain then
                    SetStatus("No se pudo comprar, reintentando...")
                    task.wait(1.5)
                    return
                end
                SetStatus("Yendo al depa despues de comprar...")
                task.wait(0.3)
            end)

            if not okCycle then
                SetStatus("Error ciclo — reintentando...")
                pcall(DestroyPlatform)
                task.wait(1.5)
            end
            if not AutoMS then break end
            if CurrentStatus == "Depas Llenos" then break end
        end

        StopLookAt()
        do
            local seg = getgenv().MsTimeSegStart or 0
            if seg > 0 then
                getgenv().MsTimeAccum = (getgenv().MsTimeAccum or 0) + (tick() - seg)
                getgenv().MsTimeSegStart = 0
                MsTimeAccum = getgenv().MsTimeAccum
                MsTimeSegStart = 0
            end
        end
        if isProtecting and currentPlatform then ForceGoUp() end
        if CurrentStatus ~= "Depas Llenos" then SetStatus("Detenido") end
    end)
end

