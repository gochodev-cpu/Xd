    if bought then
        -- Misma casa que el board comprado: free.name + free.doorPos (no adivinar otra unit)
        print("[Boreals] CloseDoor unit=", tostring(free.name), " doorPos=", free.doorPos)
        CloseAndLockDoor(free.apt, free.aptFolder, free.name, free.doorPos)
