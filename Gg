--[[
  Misma lógica para TODOS los depas (Compact / VIP / LongHouse / SingleHouse):
  - ActionText "Unlock" = ya locked → no hacer nada
  - Puerta abierta (ActionText "Close") → cerrar 1x, luego lock 1x
  - Puerta cerrada (ActionText "Open") + "Lock" → solo lock (NUNCA abrir)
]]
local function CloseAndLockDoor(apt, aptFolder, unitName, forceDoorPos)
    local root = apt or aptFolder
    if not root then
        SetStatus("Sin apt")
        return false
    end

    local folderName = unitName
        or (aptFolder and aptFolder.Name)
        or (root.Name)
        or ""
    local fixedPos = forceDoorPos or LONGHOUSE_DOOR_POS[folderName]
    if not fixedPos and aptFolder and LONGHOUSE_DOOR_POS[aptFolder.Name] then
        fixedPos = LONGHOUSE_DOOR_POS[aptFolder.Name]
        folderName = aptFolder.Name
    end

    -- Puerta principal "Door" (nunca BackDoor)
    local doorsFolder = root:FindFirstChild("Doors") or root:FindFirstChild("Doors", true)
    if not doorsFolder and aptFolder then
        doorsFolder = aptFolder:FindFirstChild("Doors", true)
    end
    local door = doorsFolder and doorsFolder:FindFirstChild("Door")
    if not door and doorsFolder then
        for _, ch in ipairs(doorsFolder:GetChildren()) do
            if ch.Name == "Door" then door = ch break end
        end
    end
    if not door then
        for _, d in ipairs(root:GetDescendants()) do
            if d.Name == "Door" and d.Parent and d.Parent.Name == "Doors" then
                door = d
                break
            end
        end
    end
    if not door and aptFolder then
        for _, d in ipairs(aptFolder:GetDescendants()) do
            if d.Name == "Door" and d.Parent and d.Parent.Name == "Doors" then
                door = d
                break
            end
        end
    end
    if not door then
        SetStatus("No Door")
        return false
    end

    -- Buscar prompts por ActionText (más fiable que depender del nombre del attach)
    local doorPrompt, lockPrompt = nil, nil
    local function scanPrompts(obj)
        if not obj then return end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local t = string.lower(tostring(d.ActionText or ""))
                if (string.find(t, "open", 1, true) or string.find(t, "close", 1, true)) and not doorPrompt then
                    doorPrompt = d
                elseif (string.find(t, "lock", 1, true) or string.find(t, "unlock", 1, true)) and not lockPrompt then
                    lockPrompt = d
                end
            end
        end
    end
    scanPrompts(door)
    if not doorPrompt or not lockPrompt then scanPrompts(doorsFolder) end
    if not doorPrompt or not lockPrompt then scanPrompts(root) end
    if (not doorPrompt or not lockPrompt) and aptFolder then scanPrompts(aptFolder) end

    local function doorText()
        return string.lower(tostring(doorPrompt and doorPrompt.ActionText or ""))
    end
    local function lockText()
        return string.lower(tostring(lockPrompt and lockPrompt.ActionText or ""))
    end

    -- "Unlock" en el prompt = ya está locked
    local function isLocked()
        return string.find(lockText(), "unlock", 1, true) ~= nil
    end
    -- "Lock" (sin unlock) = hay que lockear
    local function needsLock()
        if not lockPrompt then return false end
        local t = lockText()
        if string.find(t, "unlock", 1, true) then return false end
        return string.find(t, "lock", 1, true) ~= nil
    end

    local function angDist(a, b)
        local d = (a - b) % 360
        if d > 180 then d = 360 - d end
        return math.abs(d)
    end

    -- Parte que rota (Door Part)
    local function getSwingPart()
        if door:IsA("BasePart") then return door end
        local p = door:FindFirstChild("Door", true)
        if p and p:IsA("BasePart") then return p end
        return door:FindFirstChildWhichIsA("BasePart", true)
    end

    --[[
      Carver: ActionText de puerta SIEMPRE "Open" (no sirve).
      Cerrada: Rotation Y ≈ 0 / 90 / -90 / 180
      Abierta: Y desviada (ej. -15)
      Otros depas: "Close" = abierta | Orientation ±75/±90 abierta
    ]]
    local function isDoorOpen()
        local t = doorText()
        if string.find(t, "close", 1, true) then return true end

        local swing = getSwingPart()
        if not swing then
            -- sin parte: si solo dice Open, asumir cerrada (no abrir de más)
            return false
        end
        local oy = swing.Orientation.Y
        -- Compact/LongHouse clásico: abierta cerca de ±75
        if angDist(oy, -75) < 20 or angDist(oy, 75) < 20 then return true end
        -- Carver / general: cerrada solo si Y está en eje (0, 90, -90, 180)
        local onAxis = false
        for _, a in ipairs({ 0, 90, -90, 180, -180 }) do
            if angDist(oy, a) <= 12 then
                onAxis = true
                break
            end
        end
        if onAxis then return false end -- cerrada
        -- desviada del eje (ej. Y=-15) = abierta
        return true
    end

    local function getDoorStandPos()
        if fixedPos then return fixedPos end
        local part = getSwingPart()
        if part then return part.Position end
        if doorPrompt and doorPrompt.Parent then
            local p = doorPrompt.Parent
            if p:IsA("Attachment") then return p.WorldPosition end
            if p:IsA("BasePart") then return p.Position end
        end
        return nil
    end

    local function standAtDoor()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local pos = getDoorStandPos()
        if not pos then return end
        if currentPlatform and currentPlatform.Parent then
            local tw = TweenService:Create(currentPlatform, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = CFrame.new(pos.X, pos.Y - 3.2, pos.Z)
            })
            tw:Play()
            tw.Completed:Wait()
        end
        hrp.CFrame = CFrame.new(pos)
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
        task.wait(0.35)
    end

    -- Ya locked (Unlock) → no hacer nada
    if isLocked() then
        SetStatus("Cerrando puertas...")
        return true
    end

    -- Esperar 0.5s antes de ir al attach / cerrar-lockear
    task.wait(0.5)
    standAtDoor()

    -- Abierta (Orientation) → E cerrar, luego V lock
    if isDoorOpen() and doorPrompt then
        SetStatus("Cerrando puertas...")
        task.wait(0.5)
        FireDoorPrompt(doorPrompt)
        task.wait(1.2)
        standAtDoor()
    else
        SetStatus("Cerrando puertas...")
    end

    if isLocked() then
        SetStatus("Cerrando puertas...")
        return true
    end

    -- Cerrada + Lock → solo V (NO abrir)
    if lockPrompt and needsLock() then
        SetStatus("Cerrando puertas...")
        task.wait(0.5)
        FireDoorPrompt(lockPrompt)
        task.wait(1.0)
        if isLocked() then
            SetStatus("Cerrando puertas...")
            return true
        end
        SetStatus("Cerrando puertas...")
        return false
    end

    SetStatus("Cerrando puertas...")
    return isLocked()
end


local function FirePromptSimple(obj, forceHold)
    if not obj then return false end
    local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then return false end

    pcall(function()
        prompt.Enabled = true
        prompt.MaxActivationDistance = 60
        prompt.RequiresLineOfSight = false

        local hold = 0
        if forceHold and type(forceHold) == "number" and forceHold > 0 then
            hold = forceHold
        elseif prompt.HoldDuration and prompt.HoldDuration > 0 then
            hold = prompt.HoldDuration + 0.2
        end

        if hold > 0 then
            prompt:InputHoldBegin()
            task.wait(hold)
            prompt:InputHoldEnd()
        end
        if fireproximityprompt then
            fireproximityprompt(prompt)
        end
    end)
    return true
end

