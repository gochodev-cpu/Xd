local ConfigUtil = {
	Noclip = false,
}

local NoclipParts = {}
local RoadSidewalkFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Roads/Sidewalks")

local function SetHiddenProperty(instance, property, value)
	pcall(function()
		if sethiddenproperty then
			sethiddenproperty(instance, property, value)
		else
			instance[property] = value
		end
	end)
end

local function ExclusionsNoclip(Part)
	if not Part then return true end
	local partName = string.lower(Part.Name or "")
	if RoadSidewalkFolder and Part:IsDescendantOf(RoadSidewalkFolder) then return true end
	if Part.Name == "default" or Part.Name == "Sidewalk" or Part.Name == "Floor"
		or Part.Name == "Collision" or Part.Name == "QuaterCylinder" then
		return true
	end
	if LocalPlayer.Character and Part:IsDescendantOf(LocalPlayer.Character) then return true end
	if Part.Parent and Part.Parent:IsA("Model") and Players:GetPlayerFromCharacter(Part.Parent) then
		return true
	end
	if Part:IsA("VehicleSeat") then return true end
	if Part.Name == "AntiFall_Platform1" or Part.Name == "AntiFall_Platform2" then return true end
	if partName:find("undergroundbp") or partName:find("baseplate") or partName:find("platform") then
		return true
	end
	if Part.Name == "SafePlatform" then return true end
	return false
end

local function Reset_Noclip()
	for part, props in pairs(NoclipParts) do
		if part and part.Parent and part:IsA("BasePart") then
			SetHiddenProperty(part, "CanCollide", props.CanCollide)
		end
	end
	NoclipParts = {}
end

local function ApexNoclip()
	local Character = LocalPlayer.Character
	if not Character then return end
	local Root = Character:FindFirstChild("HumanoidRootPart")
	if not Root then return end
	local Pos = Root.Position
	local radius = 15
	local region = Region3.new(
		Pos - Vector3.new(radius, radius, radius),
		Pos + Vector3.new(radius, radius, radius)
	)
	local parts = workspace:FindPartsInRegion3(region, nil, math.huge)
	for _, part in ipairs(parts) do
		if part:IsA("BasePart") and not ExclusionsNoclip(part) then
			if not NoclipParts[part] then
				NoclipParts[part] = { CanCollide = part.CanCollide }
				SetHiddenProperty(part, "CanCollide", false)
			end
		end
	end
end

RunService.Stepped:Connect(function()
	if ConfigUtil.Noclip then
		pcall(ApexNoclip)
	elseif next(NoclipParts) then
		pcall(Reset_Noclip)
	end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.U then
		local newVal = not ConfigUtil.Noclip
		local synced = false
		pcall(function()
			if Library and Library.SetFlags and Library.SetFlags["AH_Noclip"] then
				Library.SetFlags["AH_Noclip"](newVal)
				synced = true
			end
		end)
		if not synced then
			ConfigUtil.Noclip = newVal
			if not ConfigUtil.Noclip then
				pcall(Reset_Noclip)
			end
			Notify("Noclip", ConfigUtil.Noclip and "ON (U)" or "OFF (U)", 2)
		end
		return
	end
end)




