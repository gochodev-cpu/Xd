local function BuyApartmentWithPot()
    if FindOwnedApartment() then return true end
    local free = FindFreeCompactWalkup()
    if not free then return false end
    Instant9e9To(free.cf)
    task.wait(0.6)
    pcall(function()
        local prompt = free.board and free.board:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and fireproximityprompt then fireproximityprompt(prompt) end
    end)
    task.wait(1.5)
    return FindOwnedApartment() ~= nil
end

local function PlaceUnderPot(farmPot)
    local potPart = GetPotPart(farmPot)
    if not potPart then return end
    if not EnsurePlatform() then return end
    local standCF = GetUnderPotCFrame(farmPot)
    if not standCF then return end
    local underPos = standCF.Position
    currentPlatform.CFrame = CFrame.new(underPos.X, underPos.Y - 4.3, underPos.Z)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = CFrame.new(underPos) end
    pcall(function()
        local prompt = farmPot:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and fireproximityprompt then fireproximityprompt(prompt) end
    end)
end

local function GoToOwnedCookingPot()
    local apt, _, aptFolder = FindOwnedApartment()
    if not apt then
        if not BuyApartmentWithPot() then return false end
        apt, _, aptFolder = FindOwnedApartment()
        if not apt then return false end
    end
    local pots = GetCookingPots(apt)
    if #pots == 0 and aptFolder then pots = GetCookingPots(aptFolder) end
    local farmPot = pots[1]
    if not farmPot then return false end
    local underCF = GetUnderPotCFrame(farmPot)
    if not underCF then return false end
    SlowTravel(underCF, "Yendo a la olla...", 4.5)
    PlaceUnderPot(farmPot)
    return true, farmPot
end

StartAutoMS = function()
    if AutoMS then return end
    AutoMS = true
    task.spawn(function()
        local firstCycle = true
        while AutoMS do
            if firstCycle then
                if not FindOwnedApartment() then
                    if not BuyApartmentWithPot() then task.wait(2) continue end
                end
                Instant9e9To(ShopPosition)
                task.wait(0.5)
                AutoBuyIngredients(farmAmount)
                firstCycle = false
            end

            local ok, farmPot = GoToOwnedCookingPot()
            if not ok then task.wait(1.5) continue end

            while AutoMS and not HasNoIngredients() do
                PlaceUnderPot(farmPot)
                EquipAndUse2Times("Water", farmPot)
                GoDownAndUp(18)
                PlaceUnderPot(farmPot)
                EquipAndUse2Times("Sugar Block Bag", farmPot)
                task.wait(1.2)
                EquipAndUse2Times("Gelatin", farmPot)
                GoDownAndUp(43)
                PlaceUnderPot(farmPot)
                local empty = GetTool("Empty Bag") or GetTool("Empty") or GetTool("Bag")
                if empty then EquipAndUse2Times(empty.Name, farmPot) end
                BagsMade += 1
                task.wait(1)
            end

            SlowTravel(SellPosition, "Yendo a vender...", 4.5)
            DestroyPlatform()
            SellAllBags()
            AutoBuyIngredients(farmAmount)
            task.wait(0.5)
        end
    end)
end

StopAutoMS = function()
    AutoMS = false
    DestroyPlatform()
end

