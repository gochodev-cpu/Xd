local function FindOwnedApartment()
    local myName = string.lower(LocalPlayer.Name)
    local myDisplay = string.lower(LocalPlayer.DisplayName)
    local foundApt, foundName, foundFolder = nil, nil, nil
    ForEachAptFolder(function(aptFolder)
        if foundApt then return end
        local apt = aptFolder:FindFirstChild("Apartment") or aptFolder
        local board = GetBoard(apt) or GetBoard(aptFolder)
        if board then
            local text = string.lower(GetOccupationText(board))
            if text ~= "" and (string.find(text, myName, 1, true) or string.find(text, myDisplay, 1, true)) then
                foundApt, foundName, foundFolder = apt, aptFolder.Name, aptFolder
            end
        end
    end)
    return foundApt, foundName, foundFolder
end

local function IsAptFree(board)
    local text = string.lower(GetOccupationText(board))
    if text == "" or text == "empty" or text == "for sale" or text == "available"
        or string.find(text, "vacant", 1, true) or string.find(text, "none", 1, true)
        or string.find(text, "unoccupied", 1, true) or string.find(text, "libre", 1, true)
        or string.find(text, "sale", 1, true) or string.find(text, "buy", 1, true)
        or text == "---" or text == "-" or text == "n/a" then
        return true
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.find(text, string.lower(plr.Name), 1, true)
            or string.find(text, string.lower(plr.DisplayName), 1, true) then
            return false
        end
    end
    return #text < 3
end

local function GetFrontOfBoardCFrame(boardPart)
    local look = boardPart.CFrame.LookVector
    local front = -look
    local stand = boardPart.Position + front * 2.2
    stand = Vector3.new(stand.X, boardPart.Position.Y - 1.2, stand.Z)
    if stand.Y < 1 then stand = Vector3.new(stand.X, math.max(boardPart.Position.Y - 1.2, 3), stand.Z) end
    return CFrame.new(stand, boardPart.Position)
end

-- Board de Carver a veces es Folder/GUI sin BasePart → usar puerta o prompt
local function ResolveBoardPart(board, apt, aptFolder)
    if not board then return nil end
    if board:IsA("BasePart") then return board end
    local bp = board:FindFirstChildWhichIsA("BasePart", true)
    if bp then return bp end
    local prompt = board:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        local p = prompt.Parent
        if p and p:IsA("BasePart") then return p end
        if p and p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then
            return p.Parent
        end
    end
    local doors = (apt and apt:FindFirstChild("Doors", true))
        or (aptFolder and aptFolder:FindFirstChild("Doors", true))
    local door = doors and doors:FindFirstChild("Door")
    if door then
        if door:IsA("BasePart") then return door end
        bp = door:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp end
    end
    if apt then
        bp = apt:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp end
    end
    if aptFolder then
        bp = aptFolder:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp end
    end
    return nil
end

