-- Busca River Park Towers en workspace / Map (nombre puede variar)
local function FindRiverParkTowers()
    local names = { "River Park Towers", "RiverParkTowers", "River Park Tower", "RiverPark" }
    for _, n in ipairs(names) do
        local f = workspace:FindFirstChild(n) or (workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild(n))
        if f then return f end
    end
    -- fallback: cualquier hijo con "river" + "park" en el nombre
    for _, ch in ipairs(workspace:GetChildren()) do
        local ln = string.lower(ch.Name or "")
        if ln:find("river", 1, true) and ln:find("park", 1, true) then
            return ch
        end
    end
    local map = workspace:FindFirstChild("Map")
    if map then
        for _, ch in ipairs(map:GetChildren()) do
            local ln = string.lower(ch.Name or "")
            if ln:find("river", 1, true) and ln:find("park", 1, true) then
                return ch
            end
        end
    end
    return nil
end

-- Devuelve lista de carpetas raíz de apartamentos (Map + River Park + LargeApartments)
local function GetApartmentRootFolders()
    local roots = {}
    local map = workspace:FindFirstChild("Map")
    local mapApts = map and map:FindFirstChild("Apartments")
    if mapApts then table.insert(roots, mapApts) end
    local rpt = FindRiverParkTowers()
    if rpt then
        local rptApts = rpt:FindFirstChild("Apartments") or rpt:FindFirstChild("Apartments", true)
        if rptApts then
            table.insert(roots, rptApts)
        else
            -- a veces 2A/4A/5A están directo bajo el edificio
            table.insert(roots, rpt)
        end
    end
    -- LargeApartments → Apartments (Carver1..4) — búsqueda agresiva
    local function addLarge(root)
        if not root then return end
        local apts = root:FindFirstChild("Apartments") or root:FindFirstChild("Apartments", true)
        if apts then
            table.insert(roots, apts)
        else
            table.insert(roots, root)
        end
    end
    addLarge(workspace:FindFirstChild("LargeApartments"))
    if map then addLarge(map:FindFirstChild("LargeApartments")) end
    -- por si el nombre cambia o está anidado
    for _, d in ipairs(workspace:GetDescendants()) do
        local n = string.lower(d.Name or "")
        if n == "largeapartments" or n == "large apartments" or n == "largeapartment" then
            addLarge(d)
            break
        end
    end
    return roots
end

-- Compat: un solo folder (Map) por si algo viejo lo usa
local function GetApartmentsFolder()
    local roots = GetApartmentRootFolders()
    return roots[1]
end

local function IsVipAptName(name)
    if not name then return false end
    if VIP_APT_NAMES[name] then return true end
    -- 2A, 4A, 5A exactos o con sufijo (2A_1, etc.)
    if name == "2A" or name == "4A" or name == "5A" then return true end
    if string.match(name, "^2A") or string.match(name, "^4A") or string.match(name, "^5A") then
        return true
    end
    return false
end

local function IsAllowedAptFolder(folder)
    if not folder then return false end
    local name = folder.Name
    if IsVipAptName(name) then return true end
    for _, prefix in ipairs(ALLOWED_APT_PREFIXES) do
        if name == prefix or string.find(name, prefix, 1, true) == 1 then
            return true
        end
    end
    return false
end

