    -- dinero actual del jugador (misma ruta que usa el farm de marshmallow).
    -- Antes DeliverToSitters llamaba a CardGetPlayerMoney/GetPlayerMoney, que
    -- no existen en este loader: por eso "Potato made" quedaba siempre en 0.
    local function PotatoMoney()
        local ok, result = pcall(function()
            local amount = PlayerGui:FindFirstChild("PlayerUI")
                and PlayerGui.PlayerUI:FindFirstChild("Money")
                and PlayerGui.PlayerUI.Money:FindFirstChild("Amount")
            if not amount then return 0 end
            local digits = string.gsub(tostring(amount.Text or amount.Value or "0"), "[^%d]", "")
            return tonumber(digits) or 0
        end)
        return (ok and result) or 0
    end

    local function DeliverToSitters()
        local chipsLeft = CountAnyChips()
        if chipsLeft <= 0 then return false end
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        local origin = hrp and hrp.Position or SITTERS[1].pos
        local ordered = {}
        for _, s in ipairs(SITTERS) do table.insert(ordered, s) end
        table.sort(ordered, function(a, b) return (a.pos - origin).Magnitude < (b.pos - origin).Magnitude end)
        local entregadas = 0
        for _, s in ipairs(ordered) do
            if not postFarmRunning then break end
            chipsLeft = CountAnyChips()
            if chipsLeft <= 0 then break end
            if s.clearBaseFrame then ClearRiverParkBaseFrame(s.pos, 100) end
            if not SlowTravel(s.pos, "Entregando a " .. s.name) then continue end
            task.wait(0.4)
            if not EquipAnyChips() then break end
            task.wait(0.55)
            local prompt = GetSitterPrompt(s.name) or FindPromptNear(s.pos, 12)
            if not prompt then continue end
            local chipsBefore = CountAnyChips()
            local moneyBefore = PotatoMoney()
            FirePrompt(prompt)
            task.wait(0.35)
            FirePrompt(prompt)
            task.wait(2.0)
            local dialogue = PlayerGui:FindFirstChild("DialogueUI")
            if dialogue then
                local list = dialogue:FindFirstChild("MainFrame") and dialogue.MainFrame:FindFirstChild("ResponseFrame") and dialogue.MainFrame.ResponseFrame:FindFirstChild("List")
                if list then
                    local one = list:FindFirstChild("1")
                    if one then forceClick(one) task.wait(0.6) end
                end
            end
            task.wait(0.7)
            local chipsAfter = CountAnyChips()
            if chipsAfter < chipsBefore then
                entregadas += 1
                -- esperar a que el cash se actualice (como Card TrackGain)
                task.spawn(function()
                    local best = 0
                    for _ = 1, 20 do
                        task.wait(0.35)
                        local now = PotatoMoney()
                        local gained = now - moneyBefore
                        if gained > best then best = gained end
                        if best > 0 then
                            task.wait(0.4)
                            now = PotatoMoney()
                            best = math.max(best, now - moneyBefore)
                            break
                        end
                    end
                    if best > 0 then
                        PotatoMoneyMade = (PotatoMoneyMade or 0) + best
                    end
                end)
            end
            if entregadas >= (PotatoChipsHechos or 0) then break end
        end
        return entregadas > 0
    end

    local function SubirAlMapa()
        -- Subida lenta (como MS SlowTravel) para no triggear anti-cheat
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        local targetY = math.max(originalY > 0 and originalY or 5, 5)
        if not currentPlatform or not currentPlatform.Parent then
            -- sin plataforma: subir suave en pasos, no un solo CFrame
            if hrp then
                local startY = hrp.Position.Y
                local dist = math.abs(targetY - startY)
                local secs = math.clamp(dist / 6, 4.5, 14)
                local t0 = tick()
                while tick() - t0 < secs do
                    if not hrp.Parent then break end
                    local a = math.clamp((tick() - t0) / secs, 0, 1)
                    local y = startY + (targetY - startY) * a
                    hrp.CFrame = CFrame.new(hrp.Position.X, y, hrp.Position.Z)
                    pcall(function()
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                    task.wait(0.05)
                end
                if hrp.Parent then
                    hrp.CFrame = CFrame.new(hrp.Position.X, targetY, hrp.Position.Z)
                    pcall(function()
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end
            return
        end
        local px, pz = currentPlatform.Position.X, currentPlatform.Position.Z
        local startY = currentPlatform.Position.Y
        local destPlatformY = targetY - 4.3
        local vertUp = math.abs(destPlatformY - startY)
        -- ~6 studs/s → más lento que los 3s fijos que te kickaban
        local upSeconds = math.clamp(vertUp / 6, 5.0, 16)
        local up = TweenService:Create(currentPlatform, TweenInfo.new(upSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = CFrame.new(px, destPlatformY, pz)
        })
        up:Play()
        up.Completed:Wait()
        task.wait(0.35)
        -- stayConnection ya dejó el HRP arriba; soltar plataforma sin salto extra
        if hrp and hrp.Parent then
            pcall(function()
                hrp.CFrame = CFrame.new(px, targetY, pz)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        DestroyPlatform()
        task.wait(0.2)
    end

    -- ========================================================================
    -- TP A COMPRAR (misma tecnica que el farm de marshmallow)
    --   Manda el HumanoidRootPart a 9e9: el personaje muere y respawnea, y en
    --   el CharacterAdded se lo recoloca en el destino. Es el unico tipo de
    --   viaje que el server no te devuelve, porque no es un CFrame raro en el
    --   mismo personaje sino un respawn normal.
    --   Despues de comprar, el viaje a fabricar sigue con la plataforma.
    -- ========================================================================
    local function PotatoTPTo(target)
        local dest
        if typeof(target) == "CFrame" then
            dest = target
        elseif typeof(target) == "Vector3" then
            dest = CFrame.new(target)
        else
            return false
        end

        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        pcall(DestroyPlatform)

        local gotChar, newChar
        local conn
        conn = lp.CharacterAdded:Connect(function(ch)
            gotChar = true
            newChar = ch
            if conn then conn:Disconnect() end
        end)

        -- el 9e9 mata al personaje: se silencia el EmergencyStop para que no
        -- apague el farm de potato cuando llega el Humanoid.Died
        getgenv().BorealsSuppressStop = true
        pcall(function()
            hrp.CFrame = CFrame.new(9e9, 9e9, 9e9)
        end)

        local t0 = tick()
        while not gotChar and tick() - t0 < 6 do
            task.wait(0.1)
        end
        if conn then pcall(function() conn:Disconnect() end) end
        task.wait(0.35)

        local root = newChar and newChar:FindFirstChild("HumanoidRootPart")
        if not root then
            newChar = lp.Character
            root = newChar and newChar:FindFirstChild("HumanoidRootPart")
        end
        if not root then return false end

        pcall(function()
            root.CFrame = dest
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        task.wait(0.45)
        task.delay(1.5, function()
            getgenv().BorealsSuppressStop = false
        end)

        local hrp2 = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        local quedo_ok = hrp2 and (hrp2.Position - dest.Position).Magnitude or 999
        print("[Potato] TP a comprar -> " .. string.format("%.1f, %.1f, %.1f", dest.Position.X, dest.Position.Y, dest.Position.Z) ..
            " (quedo a " .. string.format("%.0f", quedo_ok) .. " studs)")
        return quedo_ok < 40
    end

    StartPotatoFarm = function()
        if farmActive or postFarmRunning then return end
        farmActive = true
        pcall(PromptESPStart)
        pcall(FarmZoomOn)
        postFarmRunning = false
        PotatoFarmActive = true
        PotatoPostRunning = false
        PotatoChipsHechos = 0
        PotatoMoneyMade = PotatoMoneyMade or 0
        PotatoTimeStart = tick()
        originalYSaved = false
        originalY = 0
        getgenv().PotatoTimeSegStart = tick()
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if hrp then originalY = math.max(hrp.Position.Y, 4) end
        originalYSaved = true
        EnsurePlatform()
        task.spawn(function()
            while farmActive do
                local cantidadObjetivo = math.clamp(math.floor(PotatoCantidad or 5), 1, 25)
                PotatoChipsHechos = 0

                -- compra (también en cada vuelta, después de vender todo)
                if CountTool("Flour") < cantidadObjetivo or CountTool("Potato") < cantidadObjetivo then
                    if not PotatoTPTo(LuciaPos) then
                        if not SlowTravel(LuciaPos, "Lucia...") then break end
                    end
                    if not BuyFlourAndPotato(cantidadObjetivo) then break end
                end

                -- fabricar el lote
                for i = 1, cantidadObjetivo do
                    if not farmActive then break end
                    local ok = RunOneCycle()
                    if not farmActive then break end
                    if ok then
                        PotatoChipsHechos = i
                    else
                        task.wait(1)
                        ok = RunOneCycle()
                        PotatoChipsHechos = i
                    end
                end

                if not farmActive then break end

                -- VENDER: se intenta siempre, sin preguntar antes. DeliverToSitters
                -- valida adentro si hay chips. Antes el ciclo preguntaba
                -- CountAnyChips() y con un conteo en 0 se saltaba la venta y
                -- volvia a comprar con el lote sin vender.
                PotatoFarmActive = false
                task.wait(0.4)
                SubirAlMapa()
                postFarmRunning = true
                PotatoPostRunning = true
                task.wait(0.4)
                MakeSpicy()
                task.wait(0.5)

                local ventas = 0
                repeat
                    ventas += 1
                    DeliverToSitters()
                    task.wait(0.6)
                until not farmActive or CountAnyChips() <= 0 or ventas >= 3

                if CountAnyChips() > 0 then
                    print("[Potato] quedaron " .. tostring(CountAnyChips()) .. " chips sin vender")
                else
                    print("[Potato] lote vendido — recompra de insumos")
                end

                postFarmRunning = false
                PotatoPostRunning = false
                PotatoFarmActive = true
                task.wait(0.5)
            end

            farmActive = false
            postFarmRunning = false
            PotatoFarmActive = false
            PotatoPostRunning = false
            local seg = getgenv().PotatoTimeSegStart or 0
            if seg > 0 then
                getgenv().PotatoTimeAccum = (getgenv().PotatoTimeAccum or 0) + (tick() - seg)
                getgenv().PotatoTimeSegStart = 0
            end
        end)
    end

    StopPotatoFarm = function()
        farmActive = false
        pcall(PromptESPStop)
        pcall(FarmZoomOff)
        postFarmRunning = false
        PotatoFarmActive = false
        PotatoPostRunning = false
        local seg = getgenv().PotatoTimeSegStart or 0
        if seg > 0 then
            getgenv().PotatoTimeAccum = (getgenv().PotatoTimeAccum or 0) + (tick() - seg)
            getgenv().PotatoTimeSegStart = 0
        end
        DestroyPlatform()
    end    -- puente para la UI: slider de cantidad
    getgenv().Boreals_SetPotatoAmount = function(n)
        PotatoCantidad = math.clamp(math.floor(tonumber(n) or 5), 1, 25)
