end

-- Encuentra depa propio (o compra), viaja bajo la olla, limpia stove/floor
-- GoToOwnedCookingPot: encuentra depa propio + olla CookingPot
local function GoToOwnedCookingPot()
    local apt, aptName, aptFolder = FindOwnedApartment()
    local justBought = false
    if not apt then
        SetStatus("Comprando apartamento...")
        if not BuyApartmentWithPot() then return false end
        justBought = true
        apt, aptName, aptFolder = FindOwnedApartment()
        if not apt then return false end
        -- BuyApartmentWithPot ya cerró/lock si hacía falta
    end

    local pots = GetCookingPots(apt)
    if #pots == 0 and aptFolder then pots = GetCookingPots(aptFolder) end
    local farmPot = pots[1]
    if not farmPot then
        SetStatus("No se encontro Cooking Pot")
        return false
    end

    -- puerta solo al comprar; Stove/Floor al llegar al depa
    local underCF = GetUnderPotCFrame(farmPot)
    if not underCF then return false end

    local vip = aptFolder and IsVipAptName and IsVipAptName(aptFolder.Name)
    SetStatus("Yendo al depa (" .. tostring(aptName) .. ")...")
    -- VIP alto: riseSeconds nil → SlowTravel calcula tiempo según altura (más lento)
    local ok = SlowTravel(underCF, vip and "Viajando nivel piso (VIP)..." or "Viajando debajo de la olla...", nil)
    if not ok then return false end
    if not anyFarmOn() then return false end

    ClearStoveAndFloor(apt, aptFolder)

    if not farmPot.Parent then
        local left = GetCookingPots(apt)
        if #left == 0 and aptFolder then left = GetCookingPots(aptFolder) end
        farmPot = left[1]
    end
    if not farmPot then return false end

    PlaceUnderPot(farmPot)
    SetStatus(vip and "Nivel piso olla (VIP)" or "Debajo de la olla")
    return true, farmPot
end


