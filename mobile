                -- Se detecta por palabras clave de bolsa y de tamano en varios
                -- idiomas; lo que no se puede clasificar cuenta como mediana.
                local invSm, invMd, invLg = 0, 0, 0
                pcall(function()
                    local BAG_WORDS = {
                        "bag", "bolsa", "saco", "sac", "beutel", "tute", "tüte",
                        "sacchetto", "kantong", "torba", "çant", "сумка",
                        "пакет", "حقيب",
                    }
                    local SMALL_WORDS = {
                        "small", "peque", "pequen", "petit", "klein", "piccol",
                        "kecil", "küçük", "kucuk", "мал",
                        "صغير", "mini", "chic",
                    }
                    local MEDIUM_WORDS = {
                        "medium", "media", "mediana", "médio", "medio", "moyen",
                        "mittel", "med", "sedang", "orta", "сред",
                        "وسط",
                    }
                    local LARGE_WORDS = {
                        "large", "grande", "grand", "groß", "gross", "groot",
                        "besar", "büyük", "buyuk", "больш",
                        "كبير",
                    }

                    local function tiene(n, lista)
                        for _, w in ipairs(lista) do
                            if string.find(n, w, 1, true) then return true end
                        end
                        return false
                    end

                    local vistos = {}
                    local function contar(c)
                        if not c then return end
                        for _, t in ipairs(c:GetChildren()) do
                            if t:IsA("Tool") and not vistos[t] then
                                vistos[t] = true
                                local n = string.lower(t.Name)
                                -- descartar lo que NO es bolsa de malvavisco:
                                -- la "Plastic Bag" del laboratorio tambien dice
                                -- "bag" y se contaba como mediana antes de
                                -- siquiera recoger nada.
                                local esBolsa = tiene(n, BAG_WORDS)
                                if esBolsa then
                                    if string.find(n, "plastic", 1, true)
                                        or string.find(n, "plastico", 1, true)
                                        or string.find(n, "plástico", 1, true)
                                        or string.find(n, "empty", 1, true)
                                        or string.find(n, "vacia", 1, true)
                                        or string.find(n, "vacía", 1, true) then
                                        esBolsa = false
                                    end
                                end
                                if esBolsa then
                                    if tiene(n, SMALL_WORDS) then
                                        invSm += 1
                                    elseif tiene(n, LARGE_WORDS) then
                                        invLg += 1
                                                                        elseif tiene(n, MEDIUM_WORDS) then
                                        invMd += 1
                                    end
                                end
                            end
                        end
                    end

                    contar(LocalPlayer:FindFirstChild("Backpack"))
                    contar(LocalPlayer.Character)
                end)
                if invSm == invRaw.sm then invShow.sm = invSm else invRaw.sm = invSm end
                if invMd == invRaw.md then invShow.md = invMd else invRaw.md = invMd end
                if invLg == invRaw.lg then invShow.lg = invLg else invRaw.lg = invLg end

                local precioSm, precioMd, precioLg = 1470, 2840, 4150
                local totalInv = invShow.sm * precioSm + invShow.md * precioMd + invShow.lg * precioLg
                if invSmall and invSmall.SetText then
                    invSmall:SetText("[ 🍚 ] Small: " .. tostring(invShow.sm) .. "  ($" .. tostring(invShow.sm * precioSm) .. ")")
                end
                if invMedium and invMedium.SetText then
                    invMedium:SetText("[ 🍚 ] Medium: " .. tostring(invShow.md) .. "  ($" .. tostring(invShow.md * precioMd) .. ")")
                end
                if invLarge and invLarge.SetText then
                    invLarge:SetText("[ 🍚 ] Large: " .. tostring(invShow.lg) .. "  ($" .. tostring(invShow.lg * precioLg) .. ")")
                end
                if invTotal and invTotal.SetText then
                    invTotal:SetText("[ 🍚 ] Inventory total: $" .. tostring(totalInv))
                end
            end)
            task.wait(0.5)
        end
    end)

