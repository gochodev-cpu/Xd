            Flag = flag,
            Default = false,
            Callback = function(state)
                if key == "EspOn" then
                    EspOn = state and true or false
                    if EspOn and EnsureEspStarted then pcall(EnsureEspStarted) end
                else
                    if EspOpts then EspOpts[key] = state and true or false end
                end
            end,
        })
        if colors and tog and tog.Colorpicker then
            for _, c in ipairs(colors) do
                local optKey, def = c[1], c[2]
                pcall(function()
                    tog:Colorpicker({
                        Name = name .. " " .. optKey,
                        Flag = flag .. "_" .. optKey,
                        Default = def,
                        Callback = function(col)
                            if EspOpts then EspOpts[optKey] = col end
                        end,
                    })
                end)
            end
        end
        return tog
    end

