local function AutoBuyIngredients(amount)
    amount = math.clamp(math.floor(amount or farmAmount or 1), 1, 50)
    SetStatus("Comprando materiales...")

    if not PlayerGui:FindFirstChild("Shop") and not PlayerGui:FindFirstChild("DialogueUI") then
        local npc = workspace:FindFirstChild("Folders")
            and workspace.Folders:FindFirstChild("NPCs")
            and workspace.Folders.NPCs:FindFirstChild("Lamont Bell")
        local prompt = npc and npc:FindFirstChild("UpperTorso") and npc.UpperTorso:FindFirstChild("ProximityPrompt")
        if not prompt and npc then prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true) end
        if not prompt then return false end
        pcall(function()
            prompt.MaxActivationDistance = 60
            prompt.RequiresLineOfSight = false
            if fireproximityprompt then fireproximityprompt(prompt) end
        end)
        task.wait(1.0)
    end

    if not PlayerGui:FindFirstChild("Shop") then
        local option1 = PlayerGui:FindFirstChild("DialogueUI", true) and PlayerGui.DialogueUI.MainFrame.ResponseFrame.List["1"]
        if option1 then
            pcall(function()
                for _, conn in ipairs(getconnections(option1.Activated)) do conn:Fire() end
            end)
        end
        task.wait(0.8)
    end

    local shop = PlayerGui:FindFirstChild("Shop")
    if not shop then return false end

    local scrolling = shop.Main and shop.Main:FindFirstChild("ScrollingFrame")
    if not scrolling then return false end

    local items = {}
    for _, child in ipairs(scrolling:GetChildren()) do
        if child.Name == "PurchaseableItem" then table.insert(items, child) end
    end

    for round = 1, amount do
        if not AutoMS then break end
        for _, item in ipairs(items) do
            pcall(function()
                for _, conn in ipairs(getconnections(item.Activated)) do conn:Fire() end
            end)
            task.wait(0.45)
        end
    end

    local exitBtn = shop.Main and shop.Main:FindFirstChild("Exit")
    if exitBtn then
        pcall(function()
            for _, conn in ipairs(getconnections(exitBtn.Activated)) do conn:Fire() end
        end)
    end
    return true
end

local function GetToolCount(name)
    local count = 0
    local lowerName = string.lower(name)
    local function check(container)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and string.find(string.lower(t.Name), lowerName) then count += 1 end
        end
    end
    check(LocalPlayer:FindFirstChild("Backpack"))
    check(LocalPlayer.Character)
    return count
end

local function GetTool(name)
    local lowerName = string.lower(name)
    local function search(container)
        if not container then return nil end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and string.find(string.lower(t.Name), lowerName) then return t end
        end
        return nil
    end
    return search(LocalPlayer:FindFirstChild("Backpack")) or search(LocalPlayer.Character)
end

