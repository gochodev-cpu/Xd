    -- Compra SIN DIALOGO: RemoteEvents.ReliableRemoteEvent, NPC 21.
    --   payload buffer 24 / 21 / index   (1 = Flour, 2 = Potato)
    --   GetLuciaPrompt / ClickDialogueResponse / BuyItemByName quedan arriba,
    --   sin usar, por si hay que volver a la tienda.
    local NPC_ID = 21
    local ITEMS = {
        { name = "Flour",  index = 1 },
        { name = "Potato", index = 2 },
    }
    local buyRemote
    local buyIndex = {}

    local function ResolveBuyRemote()
        if buyRemote and buyRemote.Parent then return buyRemote end
        local RS = game:GetService("ReplicatedStorage")
        local okFolder, folder = pcall(function() return RS:WaitForChild("RemoteEvents", 5) end)
        if okFolder and folder then
            local okRe, re = pcall(function() return folder:WaitForChild("ReliableRemoteEvent", 5) end)
            if okRe and re then
                buyRemote = re
                print("[Buy] remote = " .. re:GetFullName())
                return buyRemote
            end
        end
        for _, n in ipairs({ "ReliableRemoteEvent", "ReliableRemote" }) do
            local d = RS:FindFirstChild(n, true)
            if d and d:IsA("RemoteEvent") then
                buyRemote = d
                print("[Buy] remote (variante) = " .. d:GetFullName())
                return buyRemote
            end
        end
        return nil
    end

    local function buyPayload(npc, index)
        local v1 = buffer.create(3)
        buffer.writeu8(v1, 0, 24)
        buffer.writeu8(v1, 1, npc)
        buffer.writeu8(v1, 2, index)
        return v1
    end

    -- compra N de un item; si el indice no entrega nada prueba el otro
    local function buyItemCount(name, index, cantidad)
        cantidad = math.max(0, math.floor(cantidad or 1))
        if CountTool(name) >= cantidad then return true end
        local remote = ResolveBuyRemote()
        if not (remote and remote.Parent) then
            print("[Buy] no encontre ReliableRemoteEvent")
            return false
        end
        local orden = {}
        local function addIdx(v)
            v = tonumber(v)
            if v and v >= 1 and v <= 5 then
                for _, x in ipairs(orden) do if x == v then return end end
                orden[#orden + 1] = v
            end
        end
        addIdx(buyIndex[name])
        addIdx(index)
        addIdx(1)
        addIdx(2)
        addIdx(3)
        addIdx(4)
        addIdx(5)
        for _, idx in ipairs(orden) do
            if not farmActive then return false end
            local v1 = buyPayload(NPC_ID, idx)
            local rondas = 0
            while CountTool(name) < cantidad and rondas < 3 do
                if not farmActive then return false end
                rondas += 1
                local falta = cantidad - CountTool(name)
                for _ = 1, falta do
                    pcall(function() remote:FireServer(v1) end)
                    -- gap con jitter: mismo ritmo que un click humano rapido
                    task.wait(0.07 + math.random() * 0.03)
                end
                local t0 = os.clock()
                while os.clock() - t0 < 1.2 do
                    if CountTool(name) >= cantidad then break end
                    task.wait(0.05)
                end
            end
            if CountTool(name) >= cantidad then
                if buyIndex[name] ~= idx then
                    buyIndex[name] = idx
                    print("[Buy] " .. name .. ": indice " .. tostring(idx) .. " (memorizado)")
                end
                return true
            end
            print("[Buy] " .. name .. ": indice " .. tostring(idx) .. " no dio nada")
        end
        print("[Buy] " .. tostring(name) .. ": no llego | en mochila=" .. tostring(CountTool(name)))
        return false
    end

