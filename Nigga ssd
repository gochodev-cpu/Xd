local PRECIO = { sm = 1470, md = 2840, lg = 4150 }

local function fmtMoney(n)
    n = math.floor(tonumber(n) or 0)
    local s = tostring(n)
    return s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function ReadInventory()
    local sm, md, lg = 0, 0, 0
    local BAG = { "bag", "bolsa", "saco", "sac" }
    local SMALL = { "small", "peque", "petit", "klein", "mini" }
    local MED = { "medium", "media", "mediana", "medio", "moyen", "mittel" }
    local LARGE = { "large", "grande", "grand", "groß", "gross" }
    local function has(n, list)
        for _, w in ipairs(list) do
            if string.find(n, w, 1, true) then return true end
        end
        return false
    end
    local seen = {}
    local function count(c)
        if not c then return end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and not seen[t] then
                seen[t] = true
                local n = string.lower(t.Name)
                local es = has(n, BAG)
                if es and (n:find("plastic") or n:find("empty") or n:find("vacia") or n:find("vacía")) then
                    es = false
                end
                if es then
                    if has(n, SMALL) then sm += 1
                    elseif has(n, LARGE) then lg += 1
                    elseif has(n, MED) then md += 1
                    end
                end
            end
        end
    end
    count(LocalPlayer:FindFirstChild("Backpack"))
    count(LocalPlayer.Character)
    return sm, md, lg
end

task.spawn(function()
    while task.wait(0.45) do
        local sm, md, lg = 0, 0, 0
        pcall(function() sm, md, lg = ReadInventory() end)
        local total = sm * PRECIO.sm + md * PRECIO.md + lg * PRECIO.lg
        valStatus.Text = tostring(CurrentStatus or "Esperando...")
        valMoney.Text = "$" .. fmtMoney(TotalMoneyMade or 0)
        valBags.Text = tostring(BagsMade or 0)
        valInv.Text = string.format("S:%d  M:%d  L:%d", sm, md, lg)
        valTotal.Text = "$" .. fmtMoney(total)
    end
end)

