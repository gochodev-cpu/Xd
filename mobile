                local parent = d.Parent
                local p
                if parent and parent:IsA("BasePart") then
                    p = parent.Position
                elseif parent and parent:IsA("Attachment") then
                    p = parent.WorldPosition
                end
                if p then
                    out[#out + 1] = { prompt = d, pos = p }
                end
            end
        end
        return out
    end

    -- Fuerza los prompts de LAS estaciones que usa el script (portapapeles,
    -- cortadoras, bolsa, bowls y ollas) mas los que estan al lado del jugador.
    -- Asi se interactua a traves de las paredes sin mirar: el juego solo deja
    -- disparar el prompt si esta "visible", y con RequiresLineOfSight = false
    -- deja de exigir que lo mires.
    -- Fuerza SOLO el prompt mas cercano al jugador (dentro de 12 studs).
    -- Antes se forzaba todo el laboratorio y el juego terminaba mostrando
    -- veinte "Interact" pegados; ahora el unico habilitado es el que tenes al
    -- lado, y encima sin exigir linea de vista para que se pueda disparar sin
    -- mirar.
    local function ForceNearbyPrompts(radius)
        radius = radius or 12
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local pos = hrp.Position

        local now = tick()
        if now >= promptForce.refreshAt or #promptForce.list == 0 then
            promptForce.refreshAt = now + 2
            promptForce.list = CollectPrompts()
        end

        local mejor, mejorDist
        for _, e in ipairs(promptForce.list) do
            if e.prompt and e.prompt.Parent then
                local d = (e.pos - pos).Magnitude
                if d <= radius and (not mejorDist or d < mejorDist) then
                    mejor, mejorDist = e, d
                end
            end
        end

        if mejor then
            pcall(function()
                mejor.prompt.Enabled = true
                mejor.prompt.RequiresLineOfSight = false
                mejor.prompt.HoldDuration = 0
                if mejor.prompt.MaxActivationDistance < 60 then
                    mejor.prompt.MaxActivationDistance = 60
                end
            end)
        end
    end


