local function EquipAndUse2Times(toolName, pot)
    if not AutoMS then return false end
    local tool = GetTool(toolName)
    if not tool then return false end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    hum:EquipTool(tool)
    task.wait(0.28)
    if pot then
        pcall(function()
            local prompt = pot:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                prompt.MaxActivationDistance = 60
                if fireproximityprompt then fireproximityprompt(prompt) end
            end
        end)
        task.wait(0.1)
    end
    for _ = 1, 2 do
        PressE()
        task.wait(0.09)
    end
    task.wait(0.22)
    return true
end

local function HasNoIngredients()
    return GetToolCount("Water") == 0 and GetToolCount("Sugar Block Bag") == 0 and GetToolCount("Gelatin") == 0
end

local function SellAllBags()
    SetStatus("Vendiendo bolsas...")
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local order = { "Small Marshmallow Bag", "Medium Marshmallow Bag", "Large Marshmallow Bag" }
    for _, name in ipairs(order) do
        while GetToolCount(name) > 0 and AutoMS do
            local tool = GetTool(name)
            if tool then
                hum:EquipTool(tool)
                task.wait(0.2)
                local npc = workspace:FindFirstChild("Folders", true) and workspace.Folders.NPCs:FindFirstChild("Lamont Bell")
                local prompt = npc and npc:FindFirstChild("UpperTorso") and npc.UpperTorso:FindFirstChild("ProximityPrompt")
                if prompt then
                    pcall(function()
                        prompt.MaxActivationDistance = 60
                        if fireproximityprompt then fireproximityprompt(prompt) end
                    end)
                end
                task.wait(0.5)
            else
                break
            end
        end
    end
end

local function Instant9e9To(targetCF)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    pcall(function() hrp.CFrame = CFrame.new(9e9, 9e9, 9e9) end)
    task.wait(0.5)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
