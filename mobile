    local function SlowTravel(targetPos, label, riseSeconds)
        if not targetPos then return false end
        if not EnsurePlatform() then return false end
        local startY = currentPlatform.Position.Y
        local vertDown = math.abs(startY - SafeHeight)
        local downSeconds = math.clamp(vertDown / 8, 3.2, 12)
        local down = TweenService:Create(currentPlatform, TweenInfo.new(downSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            CFrame = CFrame.new(currentPlatform.Position.X, SafeHeight, currentPlatform.Position.Z)
        })
        down:Play()
        down.Completed:Wait()
        if not (farmActive or postFarmRunning) then return false end
        local endPos = Vector3.new(targetPos.X, SafeHeight, targetPos.Z)
        while (farmActive or postFarmRunning) do
            if not currentPlatform or not currentPlatform.Parent then return false end
            local current = currentPlatform.Position
            local remaining = (endPos - Vector3.new(current.X, SafeHeight, current.Z)).Magnitude
            if remaining <= 2 then break end
            local direction = (endPos - Vector3.new(current.X, SafeHeight, current.Z)).Unit
            local step = math.min(SPEED * 0.1, remaining)
            currentPlatform.CFrame = CFrame.new(Vector3.new(current.X, SafeHeight, current.Z) + direction * step)
            task.wait(0.1)
        end
        if not (farmActive or postFarmRunning) then return false end
        currentPlatform.CFrame = CFrame.new(endPos.X, SafeHeight, endPos.Z)
        task.wait(0.2)
        local destY = targetPos.Y - 4.3
        local vertUp = math.abs(destY - SafeHeight)
        local upSeconds = riseSeconds or math.clamp(vertUp / 8, 4.5, 14)
        local up = TweenService:Create(currentPlatform, TweenInfo.new(upSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = CFrame.new(targetPos.X, destY, targetPos.Z)
        })
        up:Play()
        while up.PlaybackState == Enum.PlaybackState.Playing do
            if not (farmActive or postFarmRunning) then
                up:Cancel()
                DestroyPlatform()
                return false
            end
            task.wait(0.1)
        end
        task.wait(0.35)
        return true
    end

