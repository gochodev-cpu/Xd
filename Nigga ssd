local function FirePromptSimple(obj, forceHold)
    if not obj then return false end
    local prompt = obj:IsA("ProximityPrompt") and obj or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then return false end
    pcall(function()
        prompt.Enabled = true
        prompt.MaxActivationDistance = 60
        prompt.RequiresLineOfSight = false

        local hold = 0
        if forceHold and type(forceHold) == "number" and forceHold > 0 then
            hold = forceHold
        elseif prompt.HoldDuration and prompt.HoldDuration > 0 then
            hold = prompt.HoldDuration + 0.2
        end

        if hold > 0 then
            prompt:InputHoldBegin()
            task.wait(hold)
            prompt:InputHoldEnd()
        end
        if fireproximityprompt then
            fireproximityprompt(prompt)
        end
    end)
    return true
end

--[[
  Cierra y lockea la puerta del depa comprado.
  - Dispara el prompt de puerta UNA vez por intento y verifica el estado
    antes de volver a disparar (nunca dos veces seguidas: es un toggle).
  - "Abierta" = ActionText dice "close", o la hoja esta girada fuera de eje
    (Orientation.Y no multiplo de 90). Necesario porque en Carver/VIP el
    texto dice "Open" aunque la puerta este abierta.
]]
local function CloseAndLockDoor(apt, aptFolder, unitName, forceDoorPos)
    local root = apt or aptFolder
    if not root then return false end

    local folderName = unitName or (aptFolder and aptFolder.Name) or root.Name or ""
    local fixedPos = forceDoorPos or LONGHOUSE_DOOR_POS[folderName]
    if not fixedPos and aptFolder then fixedPos = LONGHOUSE_DOOR_POS[aptFolder.Name] end

    -- buscar la puerta
    local doorsFolder = root:FindFirstChild("Doors", true)
    if not doorsFolder and aptFolder then doorsFolder = aptFolder:FindFirstChild("Doors", true) end
    local door = doorsFolder and doorsFolder:FindFirstChild("Door")
    if not door then
        for _, d in ipairs(root:GetDescendants()) do
            if d.Name == "Door" and d.Parent and d.Parent.Name == "Doors" then door = d break end
        end
    end
    if not door and aptFolder then
        for _, d in ipairs(aptFolder:GetDescendants()) do
            if d.Name == "Door" and d.Parent and d.Parent.Name == "Doors" then door = d break end
        end
    end
    if not door then
        SetStatus("No se encontro la puerta")
        return false
    end

    -- buscar prompts
    local doorPrompt, lockPrompt
    local function scanPrompts(obj)
        if not obj then return end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local t = string.lower(tostring(d.ActionText or ""))
                if (string.find(t, "lock", 1, true)) and not lockPrompt then
                    lockPrompt = d -- "lock" y "unlock"
                elseif (string.find(t, "open", 1, true) or string.find(t, "close", 1, true)) and not doorPrompt then
                    doorPrompt = d
                end
            end
        end
    end
    scanPrompts(door)
    if not doorPrompt or not lockPrompt then scanPrompts(doorsFolder) end
    if not doorPrompt or not lockPrompt then scanPrompts(root) end
    if (not doorPrompt or not lockPrompt) and aptFolder then scanPrompts(aptFolder) end

    local function getSwingPart()
        if door:IsA("BasePart") then return door end
        local p = door:FindFirstChild("Door", true)
        if p and p:IsA("BasePart") then return p end
        return door:FindFirstChildWhichIsA("BasePart", true)
    end

    local function isLocked()
        if not lockPrompt then return false end
        return string.find(string.lower(tostring(lockPrompt.ActionText or "")), "unlock", 1, true) ~= nil
    end

    local function swingOffAxis()
        local part = getSwingPart()
        if not part then return false end
        local y = part.Orientation.Y % 90
        local dist = math.min(y, 90 - y)
        return dist > 8
    end

    local function doorIsOpen()
        if doorPrompt then
            local t = string.lower(tostring(doorPrompt.ActionText or ""))
            if string.find(t, "close", 1, true) then return true end
        end
        return swingOffAxis()
    end

    local function standAtDoor()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local pos = fixedPos
        if not pos then
            local part = getSwingPart()
            pos = part and (part.Position + Vector3.new(0, 1.5, 0))
        end
        if not pos then return end
        if currentPlatform and currentPlatform.Parent then
            currentPlatform.CFrame = CFrame.new(pos.X, pos.Y - 3.2, pos.Z)
        end
        hrp.CFrame = CFrame.new(pos)
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    if isLocked() then
        SetStatus("Puerta ya locked")
        return true
    end

    standAtDoor()
    task.wait(0.4)

    -- PASO 1: CERRAR (1 disparo por intento, verificando)
    if doorPrompt then
        for intento = 1, 3 do
            if not doorIsOpen() then break end
            SetStatus("Cerrando puerta (" .. intento .. "/3)...")
            standAtDoor()
            task.wait(0.25)
            FireDoorPrompt(doorPrompt)
            task.wait(1.4) -- dejar que termine la animacion
        end
        if doorIsOpen() then
            print("[SilentX] Puerta no cerro tras 3 intentos")
        else
            SetStatus("Puerta cerrada")
        end
    else
        SetStatus("Sin prompt de puerta")
    end

    -- PASO 2: LOCK
    if lockPrompt then
        for intento = 1, 3 do
            if isLocked() then break end
            SetStatus("Lock " .. intento .. "/3...")
            standAtDoor()
            task.wait(0.25)
            FireDoorPrompt(lockPrompt)
            task.wait(1.0)
        end
    end

    SetStatus(isLocked() and "Puerta asegurada" or "Lock sin confirmar")
    return isLocked()
end

