local function IsVipPotContext(pot)
    local p = pot
    while p and p ~= workspace do
        if IsVipAptName and IsVipAptName(p.Name) then return true end
        if p.Name == "2A" or p.Name == "4A" or p.Name == "5A" then return true end
        p = p.Parent
    end
    return false
end

