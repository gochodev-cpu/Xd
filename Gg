local InfStaminaOn = false
local StaminaController = nil

local function FindStaminaController()
    local ok, controller = pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        if not ps then return nil end
        local init = ps:FindFirstChild("Client.Initializer")
            or ps:FindFirstChild("ClientInitializer")
        if not init then
            -- buscar por nombre parcial
            for _, d in ipairs(ps:GetDescendants()) do
                if d:IsA("ModuleScript") and string.find(string.lower(d.Name), "movement") then
                    local mod = require(d)
                    if type(mod) == "table" and mod.Controllers then
                        for _, c in pairs(mod.Controllers) do
                            if type(c) == "table" and c.Stamina ~= nil then
                                return c
                            end
                        end
                    end
                end
            end
            return nil
        end
        local ok2, MovementControllerModule = pcall(function()
            return require(init.SharedModules.Controllers.MovementController)
        end)
        if not ok2 or type(MovementControllerModule) ~= "table" then return nil end
        if MovementControllerModule.Controllers then
            for _, c in pairs(MovementControllerModule.Controllers) do
                if type(c) == "table" and c.Stamina ~= nil then
                    return c
                end
            end
        end
        return nil
    end)
    return (ok and controller) or nil
end

local function ForceStamina()
    if not InfStaminaOn then return end
    if not StaminaController then
        StaminaController = FindStaminaController()
    end
    if StaminaController and StaminaController.Stamina ~= nil then
        local maxS = StaminaController.MaxStamina or 100
        if StaminaController.Stamina < maxS then
            StaminaController.Stamina = maxS
        end
    end
end

task.spawn(function()
    local n = 0
    while true do
        if InfStaminaOn then
            n = n + 1
            if n % 2 == 0 then
                pcall(ForceStamina)
            end
        end
        task.wait(0.03)
    end
end)

