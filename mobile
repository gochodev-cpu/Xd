-- TP forzado: manda HRP a 9e9 (respawn) y recoloca en destino (compra depa / mask)
-- Instant9e9To: TP extremo + CharacterAdded (compra Apt / mask)
local function Instant9e9To(targetCF)
    local dest
    if typeof(targetCF) == "CFrame" then
        dest = targetCF
    elseif typeof(targetCF) == "Vector3" then
        dest = CFrame.new(targetCF)
    else
        return false
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    pcall(DestroyPlatform)
    -- Evitar que Humanoid.Died del 9e9 apague el farm
    local suppressWas = SuppressEmergencyStop
    SuppressEmergencyStop = true
    local gotChar = false
    local newChar
    local conn
    conn = LocalPlayer.CharacterAdded:Connect(function(ch)
        gotChar = true
        newChar = ch
        if conn then conn:Disconnect() end
    end)
    pcall(function()
        hrp.CFrame = CFrame.new(9e9, 9e9, 9e9)
    end)
    local t0 = tick()
    while not gotChar and tick() - t0 < 6 do
        task.wait(0.1)
    end
    if conn then pcall(function() conn:Disconnect() end) end
    task.wait(0.35)
    local root = newChar and newChar:FindFirstChild("HumanoidRootPart")
    if not root then
        newChar = LocalPlayer.Character
        root = newChar and newChar:FindFirstChild("HumanoidRootPart")
    end
    if not root then
        if not suppressWas then
            task.delay(1.2, function() SuppressEmergencyStop = false end)
        end
        return false
    end
    pcall(function()
        local look = dest.LookVector
        root.CFrame = CFrame.new(dest.Position, dest.Position + look)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    task.wait(0.45)
    -- Died del 9e9 a veces llega 0.5-1s tarde; si el caller (BuyApt) ya tenía suppress, no lo bajamos
    if not suppressWas then
        task.delay(1.5, function()
            SuppressEmergencyStop = false
        end)
    end
    return true
end

-- Compra CompactWalkup libre (board prompt), cierra/lock puerta, limpia stove/floor
-- BuyApartmentWithPot: depa libre → 9e9 al Board → prompt → lock/limpia
local function BuyApartmentWithPot()
    if FindOwnedApartment() then
        SetStatus("Ya tienes departamento")
        return true
    end
    local free = FindFreeCompactWalkup()
    if not free then
        SetStatus("No hay departamentos libres")
        return false
    end

    -- Suppress durante toda la compra (9e9 + prompt + respawn tardío)
    SuppressEmergencyStop = true
    SetStatus("Going to Board " .. tostring(free.name) .. "...")
    local travelOk = Instant9e9To(free.cf)
    if not travelOk then
        SetStatus("Board travel retry...")
        travelOk = SlowTravel(free.cf, "Viajando al Board...", 5.0)
    end
    if not travelOk then
        SuppressEmergencyStop = false
        return false
    end
    -- Si el user apagó el farm a propósito, no seguir comprando
    if not AutoMS and not AutoMSMobile then
        SuppressEmergencyStop = false
        return false
    end

    task.wait(0.5)

    SetStatus("Comprando departamento...")
    FireBoardPrompt(free.board)
    task.wait(1.5)

    local bought = FindOwnedApartment() ~= nil
    if not bought then
        task.wait(1)
        bought = FindOwnedApartment() ~= nil
