-- VIP 2A/4A/5A: misma XZ, Y a nivel de piso (simple, sin rotación)
local function GetUnderPotCFrame(pot)
    local part = GetPotPart(pot)
    if not part then return nil end
    if IsVipPotContext(pot) then
        local pos = Vector3.new(part.Position.X, part.Position.Y - VIP_FLOOR_BELOW_POT, part.Position.Z)
        return CFrame.new(pos)
    end
    return CFrame.new(part.Position - Vector3.new(0, UNDER_POT_OFFSET, 0))
end

local function FindOwnedApartment()
    local myName = string.lower(LocalPlayer.Name)
    local myDisplay = string.lower(LocalPlayer.DisplayName)
    local foundApt, foundName, foundFolder = nil, nil, nil
    ForEachAptFolder(function(aptFolder)
        if foundApt then return end
        local apt = aptFolder:FindFirstChild("Apartment") or aptFolder
        local board = GetBoard(apt) or GetBoard(aptFolder)
        if board then
            local text = string.lower(GetOccupationText(board))
            if text ~= "" and (string.find(text, myName, 1, true) or string.find(text, myDisplay, 1, true)) then
                foundApt, foundName, foundFolder = apt, aptFolder.Name, aptFolder
            end
        end
    end)
    return foundApt, foundName, foundFolder
end

local function IsAptFree(board)
    local text = string.lower(GetOccupationText(board))
    if text == "" or text == "empty" or text == "for sale" or text == "available"
        or string.find(text, "vacant", 1, true) or string.find(text, "none", 1, true)
        or string.find(text, "unoccupied", 1, true) or string.find(text, "libre", 1, true)
        or string.find(text, "sale", 1, true) or string.find(text, "buy", 1, true)
        or text == "---" or text == "-" or text == "n/a" then
        return true
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.find(text, string.lower(plr.Name), 1, true)
            or string.find(text, string.lower(plr.DisplayName), 1, true) then
            return false
        end
    end
    return #text < 3
end

local function GetFrontOfBoardCFrame(boardPart)
    local look = boardPart.CFrame.LookVector
    local front = -look
    local stand = boardPart.Position + front * 2.2
    stand = Vector3.new(stand.X, boardPart.Position.Y - 1.2, stand.Z)
    if stand.Y < 1 then stand = Vector3.new(stand.X, math.max(boardPart.Position.Y - 1.2, 3), stand.Z) end
    return CFrame.new(stand, boardPart.Position)
end

-- Board de Carver a veces es Folder/GUI sin BasePart → usar puerta o prompt
local function ResolveBoardPart(board, apt, aptFolder)
    if not board then return nil end
    if board:IsA("BasePart") then return board end
    local bp = board:FindFirstChildWhichIsA("BasePart", true)
    if bp then return bp end
    local prompt = board:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        local p = prompt.Parent
        if p and p:IsA("BasePart") then return p end
        if p and p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then
            return p.Parent
        end
    end
    local doors = (apt and apt:FindFirstChild("Doors", true))
        or (aptFolder and aptFolder:FindFirstChild("Doors", true))
    local door = doors and doors:FindFirstChild("Door")
    if door then
        if door:IsA("BasePart") then return door end
        bp = door:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp end
    end
    if apt then
        bp = apt:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp end
    end
    if aptFolder then
        bp = aptFolder:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp end
    end
    return nil
end

local function FindFreeCompactWalkup()
    local candidates = {}
    local debugSkip = {}
    ForEachAptFolder(function(aptFolder)
        local apt = aptFolder:FindFirstChild("Apartment") or aptFolder
        local board = GetBoard(apt) or GetBoard(aptFolder)
        if not board and apt and apt.Parent then
            board = GetBoard(apt.Parent)
        end
        if not board then
            table.insert(debugSkip, aptFolder.Name .. ":sin Board")
            return
        end
        if not IsAptFree(board) then
            table.insert(debugSkip, aptFolder.Name .. ":ocupado(" .. tostring(GetOccupationText(board)) .. ")")
            return
        end
        local pots = GetCookingPots(apt)
        if #pots == 0 then pots = GetCookingPots(aptFolder) end
        if #pots == 0 then
            table.insert(debugSkip, aptFolder.Name .. ":sin olla")
            return
        end
        local boardPart = ResolveBoardPart(board, apt, aptFolder)
        if not boardPart or not boardPart:IsA("BasePart") then
            table.insert(debugSkip, aptFolder.Name .. ":sin boardPart")
            return
        end
        table.insert(candidates, {
            apt = apt, aptFolder = aptFolder, name = aptFolder.Name,
            board = board, boardPos = boardPart.Position, boardPart = boardPart,
            cf = GetFrontOfBoardCFrame(boardPart),
            priority = GetAptPriority(aptFolder.Name),
            doorPos = LONGHOUSE_DOOR_POS[aptFolder.Name],
        })
    end)
    if #candidates == 0 then
        print("[Boreals] FindFree: 0 candidatos")
        for _, s in ipairs(debugSkip) do
            print("[Boreals] skip:", s)
        end
        return nil, "full"
    end
    do
        for _, c in ipairs(candidates) do
            print("[Boreals] candidato:", c.name, "prio=" .. tostring(c.priority))
        end
        print("[Boreals] FindFree total=", #candidates)
    end
    -- sort por GetAptPriority (Compact primero, VIP último)
    table.sort(candidates, function(a, b)
        if a.priority ~= b.priority then return a.priority < b.priority end
        return false
    end)
    local bestPrio = candidates[1].priority
    local pool = {}
    for _, c in ipairs(candidates) do
        if c.priority == bestPrio then
            table.insert(pool, c)
        else
            break
        end
    end
    return pool[math.random(1, #pool)], nil
end

local function IsProtectedObject(obj)
    if not obj then return true end
    if obj.Name == "SafePlatform" or obj:IsA("Terrain") then return true end
    if obj:IsA("ProximityPrompt") then return true end
    local n = string.lower(obj.Name or "")
    if n == "board" or string.find(n, "board", 1, true) then return true end
    if obj:FindFirstAncestor("Board") then return true end
    if n == "cooking pot" or n == "cookingpot" or string.find(n, "cooking", 1, true) then return true end
    if n == "lamont bell" or string.find(n, "lamont", 1, true) or string.find(n, "bell", 1, true) then return true end
    local ancestor = obj
    while ancestor and ancestor ~= workspace and ancestor ~= game do
        local an = string.lower(ancestor.Name or "")
        if an == "lamont bell" or string.find(an, "lamont", 1, true) then return true end
        if an == "npcs" or an == "npc" then return true end
        ancestor = ancestor.Parent
    end
    local model = obj:FindFirstAncestorWhichIsA("Model")
    if model and Players:GetPlayerFromCharacter(model) then return true end
    if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) then return true end
    if obj:IsA("Humanoid") or obj:FindFirstChildOfClass("Humanoid") then return true end
    return false
end

local function IsWall(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    local n = string.lower(obj.Name or "")
    if n == "wall" or string.find(n, "wall", 1, true) or string.find(n, "pared", 1, true) then return true end
    if string.find(n, "fence", 1, true) or string.find(n, "barrier", 1, true) then return true end
    local s = obj.Size
    if s.Y > 4 and (s.X < 4 or s.Z < 4) then return true end
    if s.Y > 6 and s.X * s.Z < 50 then return true end
    return false
end

